{
  "extends": "@workspace/typescript-config/react-library.json",
  "compilerOptions": {
    // The page is bundled by bun and the server run by bun or node from a
    // bundle, so resolve like a bundler (workspace packages are TS source).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
