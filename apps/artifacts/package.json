{
  "name": "artifacts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run build:public && bun build src/server.ts --target=node --outfile=dist/server.js",
    "build:pages": "bun build ./index.html ./site.html --outdir=dist/public --production --splitting",
    "build:public": "bun run build:pages && bun run build:runtime",
    "build:runtime": "bun build ./src/site-runtime.ts --outdir=dist/public --production --entry-naming=[name]-[hash].[ext]",
    "dev": "bun src/server.ts --watch",
    "lint": "ultracite check",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@workspace/artifacts-kit": "workspace:*",
    "@workspace/chat-ui": "workspace:*",
    "@workspace/contract": "workspace:*",
    "@workspace/shared": "workspace:*",
    "@workspace/site-ui": "workspace:*",
    "@workspace/slide-ui": "workspace:*",
    "@workspace/ui": "workspace:*",
    "html-to-image": "catalog:",
    "jspdf": "^4.2.1",
    "mermaid": "catalog:",
    "pptxgenjs": "^4.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sucrase": "catalog:",
    "tailwindcss": "^4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "jszip": "^3.10.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
