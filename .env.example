# Copy to .env and adjust. Every variable is optional: the web app boots with an
# empty .env and features that need a missing value degrade instead of failing.

# --- Database (docker-compose `postgres` service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
# Used by the app and migrations once packages/db lands.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# --- Auth (Better Auth) ---
# Signs sessions and encrypts tokens. Generate with `openssl rand -base64 32`.
# Unset in development: a fixed dev-only secret is used, with a warning.
# Unset in production: sign-in stays off rather than use a known key.
BETTER_AUTH_SECRET=
# The public origin (https://chat.example.com); inferred per request when unset.
BETTER_AUTH_URL=http://localhost:3000
# Social sign-in appears only when both halves of a pair are set (or when
# app.config.yaml `auth.social` configures the provider).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web search (optional `search` compose profile) ---
SEARXNG_PORT=8080
# Any long random string; only used to sign SearXNG's own cookies.
SEARXNG_SECRET=dev-only-change-me
# Setting this makes SearXNG the `web_search` backend unless app.config.yaml
# `search.backend` picks another. Models with built-in search use theirs.
SEARXNG_URL=http://localhost:8080
# Paid backends, used when `search.backend` names them (keys stay here, not in
# the YAML). Without a key the backend is simply unavailable.
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# --- File storage (app.config.yaml `storage`) ---
# Only for `driver: s3` (S3, R2, MinIO). The local volume needs nothing.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Tooling ---
# Port Playwright serves the production build on for E2E runs.
E2E_PORT=3100

# --- Secrets at rest (D24) ---
# Seals provider keys, MCP header secrets and MCP OAuth tokens (AES-256-GCM).
# 32 random bytes, base64 or hex: `openssl rand -base64 32`. Required in
# production (NODE_ENV=production): without it those features turn off.
# Elsewhere an insecure development key stands in, with a warning.
ENCRYPTION_KEY=
# To rotate: move the old key here (comma-separated for several) and set a new
# ENCRYPTION_KEY. Old secrets still open and are resealed when next written.
ENCRYPTION_KEY_PREVIOUS=
