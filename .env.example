# Copy to .env and adjust. Every variable is optional: the web app boots with an
# empty .env and features that need a missing value degrade instead of failing.

# --- Database (docker-compose `postgres` service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
# Used by the app and migrations. Leave it empty (or unset) and the server
# runs on an embedded database (PGlite) in `./.data/pglite`, migrated at boot:
# fine for `bun dev` and trying things out, one process only, not for
# deployments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# --- Auth (Better Auth) ---
# Signs sessions and encrypts tokens. Generate with `openssl rand -base64 32`.
# Unset in development: a fixed dev-only secret is used, with a warning.
# Unset in production: sign-in stays off rather than use a known key.
# Also keys the local file store's signed download links (derived, not reused).
BETTER_AUTH_SECRET=
# The public origin (https://chat.example.com); inferred per request when unset.
# Sign-in works from this origin only; when it's localhost, 127.0.0.1 or [::1],
# from the other two on the same scheme and port as well.
BETTER_AUTH_URL=http://localhost:3000
# Other origins sign-in accepts, exactly, comma-separated: another hostname for
# the same server, or a LAN address (`https://chat.example.org,
# http://192.168.1.20:3000`). No paths or wildcards; entries that aren't an
# origin are ignored, with a warning at start. Use this rather than Better
# Auth's own BETTER_AUTH_TRUSTED_ORIGINS, which it applies unchecked.
# See docs/self-hosting.md, "Behind a proxy".
TRUSTED_ORIGINS=
# Social sign-in appears only when both halves of a pair are set (or when
# app.config.yaml `auth.social` configures the provider).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Microsoft (Entra ID): read only through app.config.yaml
# `auth.microsoft` (`clientId: ${MICROSOFT_CLIENT_ID}`); see docs/self-hosting.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Proxies in front of the app whose X-Forwarded-For entries are believed: IP
# addresses and CIDR ranges, comma-separated (for example
# `127.0.0.1, ::1, 172.16.0.0/12` for a proxy on the host or a Docker network).
# Sign-in rate limits and the address kept on each session come from the
# first hop, read from the right, that isn't one of these. Unset, only the
# last hop counts. See docs/self-hosting.md, "Behind a proxy".
TRUSTED_PROXIES=

# --- Web search (optional `search` compose profile) ---
SEARXNG_PORT=8080
# Any long random string; only used to sign SearXNG's own cookies.
SEARXNG_SECRET=dev-only-change-me
# Setting this makes SearXNG the `web_search` backend unless app.config.yaml
# `search.backend` picks another. Models with built-in search use theirs.
SEARXNG_URL=http://localhost:8080
# Paid backends, used when `search.backend` names them (keys stay here, not in
# the YAML). Without a key the backend is simply unavailable.
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# --- File storage (app.config.yaml `storage`) ---
# Only for `driver: s3` (S3, R2, MinIO). The local volume needs nothing.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Tooling ---
# Port Playwright serves the production build on for E2E runs.
E2E_PORT=3100
# Set to 1 to serve the component galleries under /dev/*. Unset, they 404.
# Checked per request, so one build serves both.
ENABLE_DEV_ROUTES=

# --- Secrets at rest (D24) ---
# Seals provider keys, MCP header secrets and MCP OAuth tokens (AES-256-GCM).
# 32 random bytes, base64 or hex: `openssl rand -base64 32`. Required in
# production (NODE_ENV=production): without it those features turn off.
# Elsewhere an insecure development key stands in, with a warning.
ENCRYPTION_KEY=
# To rotate: move the old key here (comma-separated for several) and set a new
# ENCRYPTION_KEY. Old secrets still open and are resealed when next written.
ENCRYPTION_KEY_PREVIOUS=

# --- Docker sandboxes (optional `sandbox` compose profile) ---
# Shared secret between web and sandbox-runner; the runner refuses every call
# without it. Any long random string, e.g. `openssl rand -hex 32`.
SANDBOX_RUNNER_TOKEN=
SANDBOX_RUNNER_URL=http://localhost:7070
# auto (gVisor if the host has it, else runc with a warning) | runsc | runc
SANDBOX_RUNTIME=auto
# none (default) | allowlist (via SANDBOX_EGRESS_PROXY) | open
SANDBOX_EGRESS=none
SANDBOX_EGRESS_PROXY=
SANDBOX_IMAGE=node:24-bookworm-slim
# Previews are served from their own origin, never the app's.
SANDBOX_PREVIEW_URL=http://{id}-{port}.sandbox.localhost:7071
SANDBOX_RUNNER_PORT=7070
SANDBOX_PREVIEW_PORT=7071

# --- Artifact previews (`bun dev`, or the optional `artifacts` compose profile) ---
# Where the artifact runtime (apps/artifacts) is served: its own origin, never
# the app's (D24). Unset: HTML and SVG preview in a srcdoc frame, and React and
# Mermaid show their source only.
ARTIFACTS_ORIGIN=http://artifacts.localhost:3910
ARTIFACTS_PORT=3910
# App origins allowed to embed the runtime, comma-separated. Unset: any
# localhost port, for development. Set it to the app's public origin in production.
ARTIFACTS_APP_ORIGINS=

# Voice (docs/voice.md): `docker compose --profile voice up -d`, then point
# app.config.yaml's `voice:` at these. Unset, voice is off.
# VOICE_STT_URL=http://localhost:8000/v1
# VOICE_TTS_URL=http://localhost:8880/v1
# VOICE_STT_PORT=8000
# VOICE_TTS_PORT=8880

# --- Docker builds on a corporate network (docs/self-hosting.md) ---
# Set these in the shell, not here: this file is also the web container's
# environment. BUILD_CA_PEM is the text of a root CA that intercepts TLS, and
# BUILD_NPMRC the text of an .npmrc for a company npm mirror. `bun install`
# reads both as build secrets; neither is stored in an image.
#   BUILD_CA_PEM="$(cat ~/corporate-ca.pem)" docker compose up -d --build
