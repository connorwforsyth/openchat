// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`first run: Docker with every provider and a host gateway > writes .env 1`] = `
"# Copy to .env and adjust. Every variable is optional: the web app boots with an
# empty .env and features that need a missing value degrade instead of failing.

# --- Database (docker-compose \`postgres\` service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
# Used by the app and migrations. Leave it empty (or unset) and the server
# runs on an embedded database (PGlite) in \`./.data/pglite\`, migrated at boot:
# fine for \`bun dev\` and trying things out, one process only, not for
# deployments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# --- Auth (Better Auth) ---
# Signs sessions and encrypts tokens. Generate with \`openssl rand -base64 32\`.
# Unset in development: a fixed dev-only secret is used, with a warning.
# Unset in production: sign-in stays off rather than use a known key.
# Also keys the local file store's signed download links (derived, not reused).
BETTER_AUTH_SECRET=
# The public origin (https://chat.example.com); inferred per request when unset.
# Sign-in works from this origin only; when it's localhost, 127.0.0.1 or [::1],
# from the other two on the same scheme and port as well.
BETTER_AUTH_URL=http://localhost:3000
# Other origins sign-in accepts, exactly, comma-separated: another hostname for
# the same server, or a LAN address (\`https://chat.example.org,
# http://192.168.1.20:3000\`). No paths or wildcards; entries that aren't an
# origin are ignored, with a warning at start. Use this rather than Better
# Auth's own BETTER_AUTH_TRUSTED_ORIGINS, which it applies unchecked.
# See docs/self-hosting.md, "Behind a proxy".
TRUSTED_ORIGINS=
# Social sign-in appears only when both halves of a pair are set (or when
# app.config.yaml \`auth.social\` configures the provider).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Microsoft (Entra ID): read only through app.config.yaml
# \`auth.microsoft\` (\`clientId: \${MICROSOFT_CLIENT_ID}\`); see docs/self-hosting.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Proxies in front of the app whose X-Forwarded-For entries are believed: IP
# addresses and CIDR ranges, comma-separated (for example
# \`127.0.0.1, ::1, 172.16.0.0/12\` for a proxy on the host or a Docker network).
# Sign-in rate limits and the address kept on each session come from the
# first hop, read from the right, that isn't one of these. Unset, only the
# last hop counts. See docs/self-hosting.md, "Behind a proxy".
TRUSTED_PROXIES=

# --- Web search (optional \`search\` compose profile) ---
SEARXNG_PORT=8080
# Any long random string; only used to sign SearXNG's own cookies.
SEARXNG_SECRET=fake-random-1
# Setting this makes SearXNG the \`web_search\` backend unless app.config.yaml
# \`search.backend\` picks another. Models with built-in search use theirs.
SEARXNG_URL=http://localhost:8080
# Paid backends, used when \`search.backend\` names them (keys stay here, not in
# the YAML). Without a key the backend is simply unavailable.
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# --- File storage (app.config.yaml \`storage\`) ---
# Only for \`driver: s3\` (S3, R2, MinIO). The local volume needs nothing.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Tooling ---
# Port Playwright serves the production build on for E2E runs.
E2E_PORT=3100
# Set to 1 to serve the component galleries under /dev/*. Unset, they 404.
# Checked per request, so one build serves both.
ENABLE_DEV_ROUTES=

# --- Secrets at rest (D24) ---
# Seals provider keys, MCP header secrets and MCP OAuth tokens (AES-256-GCM).
# 32 random bytes, base64 or hex: \`openssl rand -base64 32\`. Required in
# production (NODE_ENV=production): without it those features turn off.
# Elsewhere an insecure development key stands in, with a warning.
ENCRYPTION_KEY=
# To rotate: move the old key here (comma-separated for several) and set a new
# ENCRYPTION_KEY. Old secrets still open and are resealed when next written.
ENCRYPTION_KEY_PREVIOUS=

# --- Docker sandboxes (\`bun dev\` starts the runner when Docker is running) ---
# Shared secret between web and sandbox-runner; the runner refuses every call
# without it. Any long random string, e.g. \`openssl rand -hex 32\`.
SANDBOX_RUNNER_TOKEN=
SANDBOX_RUNNER_URL=http://localhost:7070
# auto (gVisor if the host has it, else runc with a warning) | runsc | runc
SANDBOX_RUNTIME=auto
# Where sandboxes may connect is \`sandbox.egress\` in app.config.yaml. Set this
# (open | allowlist | none) only to override its mode for one deployment.
SANDBOX_EGRESS=
# The runner's container name; change it to run a second checkout's runner.
SANDBOX_RUNNER_CONTAINER=sandbox-runner
SANDBOX_IMAGE=node:24-bookworm-slim
# Previews are served from their own origin, never the app's.
SANDBOX_PREVIEW_URL=http://{id}-{port}.sandbox.localhost:7071
SANDBOX_RUNNER_PORT=7070
SANDBOX_PREVIEW_PORT=7071

# --- Artifact previews (\`bun dev\`, or the optional \`artifacts\` compose profile) ---
# Where the artifact runtime (apps/artifacts) is served: its own origin, never
# the app's (D24). Unset: HTML and SVG preview in a srcdoc frame, and React and
# Mermaid show their source only.
ARTIFACTS_ORIGIN=http://artifacts.localhost:3910
ARTIFACTS_PORT=3910
# App origins allowed to embed the runtime, comma-separated. Unset: any
# localhost port, for development. Set it to the app's public origin in production.
ARTIFACTS_APP_ORIGINS=

# Voice (docs/voice.md): \`docker compose --profile voice up -d\`, then point
# app.config.yaml's \`voice:\` at these. Unset, voice is off.
# VOICE_STT_URL=http://localhost:8000/v1
# VOICE_TTS_URL=http://localhost:8880/v1
# VOICE_STT_PORT=8000
# VOICE_TTS_PORT=8880

# --- Docker builds on a corporate network (docs/self-hosting.md) ---
# Set these in the shell, not here: this file is also the web container's
# environment. BUILD_CA_PEM is the text of a root CA that intercepts TLS, and
# BUILD_NPMRC the text of an .npmrc for a company npm mirror. \`bun install\`
# reads both as build secrets; neither is stored in an image.
#   BUILD_CA_PEM="$(cat ~/corporate-ca.pem)" docker compose up -d --build

# --- Set by \`bun run setup\` ---
ANTHROPIC_API_KEY=fake-anthropic-key-placeholder
GATEWAY_API_KEY=fake-gateway-key-placeholder
OPENAI_API_KEY=fake-openai-key-placeholder
"
`;

exports[`first run: Docker with every provider and a host gateway > writes app.config.yaml, which the app accepts 1`] = `
"# Instance configuration (PLAN.md §9, D18). Copy to app.config.yaml, or point
# CONFIG_PATH at your copy. Every section is optional: with no file at all the
# app boots on defaults and falls back to a local Ollama.
#
# Secrets come from the environment as \${NAME} (or \${NAME:-fallback}); never
# write them here. A value that is just \${NAME} with NAME unset counts as
# absent, so a missing key disables that provider instead of failing boot.
# Changes apply on restart. Invalid config fails at boot with the path and
# reason for every problem.
version: 1

# The product name lives only here (and in the root package.json and image
# names); everything else reads it at runtime.
brand:
  name: Everything
  appId: dev.example.app
  urlScheme: example
  # SVG, PNG or JPEG, relative to this file. One SVG is enough: drawn in
  # currentColor it follows the theme; with its own colours it's shown as is.
  logo: ./brand/logo.svg
  # logoDark: ./brand/logo-dark.svg   # a multi-colour logo's dark-theme version
  # favicon: ./brand/icon.svg         # the square mark for tab and home-screen icons
  # iconBackground: black             # behind the mark on home-screen icons

auth:
  signup: open # open | invite | domain | sso; the first user is always admin
  domains: [] # for signup: domain, e.g. [example.com]
  oidc: [] # SSO: [{ id, name, issuer, clientId, clientSecret }]
  # social:
  #   github: { clientId: \${GITHUB_CLIENT_ID}, clientSecret: \${GITHUB_CLIENT_SECRET} }
  # Sign in with Microsoft (Entra ID). Off until both credentials are set;
  # see docs/self-hosting.md, "Sign in with Microsoft (Entra ID)".
  # microsoft:
  #   clientId: \${MICROSOFT_CLIENT_ID}
  #   clientSecret: \${MICROSOFT_CLIENT_SECRET}
  #   tenantId: organizations   # common | organizations | consumers | <tenant GUID or domain>
  #   allowedDomains: []        # e.g. [contoso.com]; empty allows any. A filter, not a security boundary
  #   allowedTenants: []        # tenant GUIDs (the \`tid\` claim); empty allows any
  #   autoProvision: false      # true: allowed users get an account without an invite; needs a tenant GUID or allowedTenants
  #   name: Microsoft           # the button reads "Continue with <name>"
  #   photo: { enabled: true, maxBytes: 1048576 }

providers:
  anthropic: { apiKey: "\${ANTHROPIC_API_KEY}" }
  openai: { apiKey: "\${OPENAI_API_KEY}" }
  gateway: { baseURL: http://host.docker.internal:4000/v1, type: openai-compatible, apiKey: "\${GATEWAY_API_KEY}" }

models:
  aliases:
    fast: openai:gpt-5-mini
    strong: anthropic:claude-opus-5-5
  default: strong
  auto: { enabled: true, cheap: fast, strong: strong }
  # Image generation (\`generate_image\`): its own list, never in the chat
  # picker. \`discover: true\` adds a discovering provider's image models (the
  # gateway's \`type: image\`). Calls ask first unless \`approval: auto\`.
  # image: { default: openai:gpt-image-1, discover: false, approval: ask }
  # Usage is priced and the picker rated from the repo's model catalogue
  # (packages/config/src/catalog: models.dev list prices, Gateway speed, a
  # curated intelligence list). \`prices\` and \`ratings\` here override it.
  # Prices are micro-USD per million tokens; per-image prices sit beside them:
  # prices: { "openai:gpt-image-1": { imageMicros: 40000 } }
  # ratings: { strong: { speed: 3, intelligence: 5 } }
  # One line under each model in the picker, by alias or provider:model ref.
  # Beats what a provider's catalog says; \`auto\` has its own.
  descriptions:
    fast: Quick everyday answers
    strong: Hard problems and long documents
  # Defaults to auto.cheap. Set to false to name chats from their first message.
  # conversationTitleModel: fast

  # Costs are kept in US dollars; this only changes how they're shown, at a
  # fixed rate you set (nothing is fetched). Budgets are typed in this currency.
  # usage:
  #   currency: { code: AUD, perUsd: 1.52 }

  # Instance-wide limits; each org chooses within them in the admin UI.
policies:
  chatContext: [ personal, team, org ]
  auditPolicy: allowed # allowed | forbidden
  personalKeyFallback: allowed
  instanceKeys: { personal: true, team: false, org: false }
  publishGate: { default: informational, allowed: [ informational, no-regressions ] }
  sampledScoring: allowed
  persistClientCache: allowed # forbidden: no client keeps its query cache on disk (D28)

decider:
  adapter: llm-fallback # llm-fallback | jev | none
  model: fast
  thresholds: { autoRouteStrong: 0.6, needsRetrieval: 0.5, riskAsk: 0.3, riskBlock: 0.7 }

search:
  native: true # use the provider's own web search when the model has it
  backend: searxng # none | searxng | brave | tavily | exa
  searxng: { url: "\${SEARXNG_URL:-http://localhost:8080}" }
  # brave: { apiKey: "\${BRAVE_API_KEY}" }

sandbox:
  default: none # just-bash | docker | e2b | vercel | microsandbox | none
  docker:
    runnerUrl: "\${SANDBOX_RUNNER_URL:-http://sandbox-runner:7070}"
    token: "\${SANDBOX_RUNNER_TOKEN}"
    runtime: runsc # gVisor; the runner warns and falls back to runc if it's missing
    limits: { cpu: 2, memoryMb: 2048, diskMb: 10240 }
  # Where sandboxes may connect: open (anywhere) | allowlist (only \`allow\`,
  # through the runner's proxy) | none. SANDBOX_EGRESS overrides \`mode\`.
  # \`allow\` takes hostnames, or \`*.example.com\` for any subdomain.
  egress:
    mode: open
    allow:
      - registry.npmjs.org
      - registry.yarnpkg.com
      - pypi.org
      - files.pythonhosted.org
      - github.com
      - api.github.com
      - codeload.github.com
      - objects.githubusercontent.com
      - raw.githubusercontent.com
      - release-assets.githubusercontent.com

# ./.data is git-ignored; in the Docker image it's the \`web-data\` volume.
storage: { driver: local, path: ./.data/files }
# storage: { driver: s3, bucket: files, endpoint: "\${S3_ENDPOINT}", accessKeyId: "\${S3_ACCESS_KEY_ID}", secretAccessKey: "\${S3_SECRET_ACCESS_KEY}" }

embeddings: { model: openai:text-embedding-3-small }

# Read at build time, not boot (D19): rebuild after changing it. This block is
# the only place to choose; ICON_* in the environment is ignored while it's here.
icons: { set: phosphor } # e.g. { set: material, style: rounded, weight: 400, fill: false }

# Interface fonts, from npm (nothing is downloaded). Compiled in like icons:
# only the chosen pair ships; \`bun dev\` picks a change up on restart.
# sans: geist | inter | open-sans | ibm-plex-sans | figtree | manrope
# mono: geist-mono | jetbrains-mono
fonts: { sans: geist, mono: geist-mono }

observability: { otlp: null, recordContent: false } # otlp: { endpoint: "\${OTEL_EXPORTER_OTLP_ENDPOINT}" }; recordContent puts prompts on spans
# userTracesUrl: "https://cloud.langfuse.com/project/<project-id>/users/{userId}"   # admins get a link from Settings → Usage

limits:
  requestsPerMinute: 60
  uploadMaxMb: 25
  memoryMaxChars: 8000
  # budgets: { user: { period: month, limitMicros: 20000000 } }   # 20 USD

  # Scheduled tasks run unattended and spend tokens with nobody watching, so
  # these guardrails are on by default (all optional; these are the defaults).
  # schedules:
  #   minIntervalMinutes: 60      # the shortest gap a recurring task may have
  #   maxRunsPerUserPerDay: 24    # rolling 24 hours, "Run now" included
  #   runStepBudget: 8            # agent steps per run
  #   runTokenBudget: 20000       # input + output tokens per run
  #   defaultModel: fast          # for tasks on ordinary chats (null: \`fast\` if aliased)

features:
  importers: true
  publicLinks: false
  chatModes: false # the composer's Chat / Code switch; off, every chat gets the sandbox tools

# Connectors (184): MCP servers you offer every user. Each user sees them in
# Settings > Connectors and can turn them on or off, unless you say otherwise:
#   default: on | off | required   on (the default) or off until a user flips it;
#                                  required is always on and can't be turned off
#   allowUserOverride: false       fixes the toggle at \`default\` (shown locked)
#   reason: "..."                  shown next to a locked toggle
#   tools: { allow: [...], deny: [...], required: [...] }   by the server's own tool names;
#     denied tools never reach users; required ones stay on (users switch the rest, 188)
# Secrets go in \${ENV} references, never in this file. A header or env value
# whose variable is unset marks only that server "needs setup"; boot carries on.
# stdio servers run in the desktop app only; the web app lists them as such.
mcp:
  servers: []
  # servers:
  #   # A remote (Streamable HTTP) server with a token from the environment.
  #   - name: docs                      # tool prefix: docs__search, ...
  #     title: Company docs
  #     description: Search the handbook and runbooks
  #     url: https://mcp.example.com/mcp
  #     headers: { Authorization: "\${DOCS_MCP_AUTHORIZATION}" }   # e.g. "Bearer ..."
  #     tools: { deny: [delete_page] }
  #   # Each user signs in with their own account (per-user OAuth tokens).
  #   - name: tracker
  #     url: https://mcp.tracker.example.com/mcp
  #     auth: { type: oauth, scopes: [read] }
  #     default: off
  #   # Always on for everyone; users see why it's locked.
  #   - name: audit
  #     title: Audit log
  #     url: "\${AUDIT_MCP_URL:-http://audit-mcp:8080/mcp}"
  #     default: required
  #     reason: Required by IT for compliance
  #   # A local stdio server, for the desktop app.
  #   - name: files
  #     transport: stdio
  #     command: npx
  #     args: ["-y", "@modelcontextprotocol/server-filesystem", "~/Documents"]
  #     default: off
  # Whether users may add their own servers in the MCP Library.
  userServers:
    allowed: true
    transports: [ http, sse ]
    hosts: [] # e.g. ["*.example.com"]; empty means any public host

# What the UI calls a feature, and where it lives (docs/self-hosting.md,
# "Renaming features for your fork"). Code, the database and the API keep
# the id (\`mcp\`); only the words and the settings address change.
# terms:
#   mcp:
#     label: MCP servers      # default; plural, for headings and menus
#     singular: MCP server    # one of them, used mid-sentence
#     slug: mcp               # → /settings/mcp (old addresses redirect here)
#     locales:                # for languages that inflect
#       de: { label: MCP-Server, singular: MCP-Server }

artifacts:
  origin: null # a separate origin for artifacts and previews, e.g. https://artifacts.example.com
  kinds:
    # The kinds people and the model may make. A kind left out isn't offered
    # (the model's tools, "Make something new", the kind filters); artifacts
    # of it still open, read only. Off by default: markdown (documents stand
    # in), html and react (sites stand in) and code (Code mode). Add any of
    # them back to this list to turn it on.
    enabled: [ document, site, presentation, spreadsheet, diagram, mermaid, svg, image ]
    site:
      # Sites (125): small static websites, published to a link on the runtime's origin
      enabled: true
      # stack: deprecated and ignored (163). Pages are TSX built from
      # @workspace/site-ui, or plain HTML; there are no stacks to pick.
      # The public origins sites may load fonts, styles, scripts and images
      # from; their CSP blocks everything else. https only; https://*.host
      # covers subdomains. These are the defaults.
      allowedOrigins:
        - https://fonts.googleapis.com
        - https://fonts.gstatic.com
        - https://cdnjs.cloudflare.com
        - https://cdn.jsdelivr.net

# Voice conversations (docs/voice.md). Off until configured: no URLs (local)
# or no key (openai) and the call button stays hidden.
#   local:  \`docker compose --profile voice up -d\` runs Whisper (Speaches) and
#           Kokoro; both stay on this machine.
#   openai: OpenAI's audio API and, for speech to speech, Realtime. The key
#           falls back to providers.openai.apiKey.
voice:
  provider: local # local | openai
  stt: { url: "\${VOICE_STT_URL}", model: Systran/faster-whisper-base.en }
  tts: { url: "\${VOICE_TTS_URL}", model: kokoro, voice: af_heart }
  # openai: { apiKey: "\${OPENAI_API_KEY}", sttModel: gpt-4o-mini-transcribe, ttsModel: gpt-4o-mini-tts, voice: alloy, realtimeModel: gpt-realtime }
  maxUploadMb: 10
"
`;

exports[`first run: Docker with every provider and a host gateway > writes docker-compose.override.yml only for Docker 1`] = `
"# Written by \`bun run setup\`: mounts app.config.yaml into \`web\`
# (docs/self-hosting.md). Your own additions are kept on a re-run.

services:
  web:
    environment:
      CONFIG_PATH: /config/app.config.yaml
    volumes:
      - ./app.config.yaml:/config/app.config.yaml:ro
    extra_hosts:
      - host.docker.internal:host-gateway
"
`;

exports[`first run: local dev on PGlite with Ollama and every service > writes .env 1`] = `
"# Copy to .env and adjust. Every variable is optional: the web app boots with an
# empty .env and features that need a missing value degrade instead of failing.

# --- Database (docker-compose \`postgres\` service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
# Used by the app and migrations. Leave it empty (or unset) and the server
# runs on an embedded database (PGlite) in \`./.data/pglite\`, migrated at boot:
# fine for \`bun dev\` and trying things out, one process only, not for
# deployments.
DATABASE_URL=

# --- Auth (Better Auth) ---
# Signs sessions and encrypts tokens. Generate with \`openssl rand -base64 32\`.
# Unset in development: a fixed dev-only secret is used, with a warning.
# Unset in production: sign-in stays off rather than use a known key.
# Also keys the local file store's signed download links (derived, not reused).
BETTER_AUTH_SECRET=
# The public origin (https://chat.example.com); inferred per request when unset.
# Sign-in works from this origin only; when it's localhost, 127.0.0.1 or [::1],
# from the other two on the same scheme and port as well.
BETTER_AUTH_URL=http://localhost:3000
# Other origins sign-in accepts, exactly, comma-separated: another hostname for
# the same server, or a LAN address (\`https://chat.example.org,
# http://192.168.1.20:3000\`). No paths or wildcards; entries that aren't an
# origin are ignored, with a warning at start. Use this rather than Better
# Auth's own BETTER_AUTH_TRUSTED_ORIGINS, which it applies unchecked.
# See docs/self-hosting.md, "Behind a proxy".
TRUSTED_ORIGINS=
# Social sign-in appears only when both halves of a pair are set (or when
# app.config.yaml \`auth.social\` configures the provider).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Microsoft (Entra ID): read only through app.config.yaml
# \`auth.microsoft\` (\`clientId: \${MICROSOFT_CLIENT_ID}\`); see docs/self-hosting.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Proxies in front of the app whose X-Forwarded-For entries are believed: IP
# addresses and CIDR ranges, comma-separated (for example
# \`127.0.0.1, ::1, 172.16.0.0/12\` for a proxy on the host or a Docker network).
# Sign-in rate limits and the address kept on each session come from the
# first hop, read from the right, that isn't one of these. Unset, only the
# last hop counts. See docs/self-hosting.md, "Behind a proxy".
TRUSTED_PROXIES=

# --- Web search (optional \`search\` compose profile) ---
SEARXNG_PORT=8080
# Any long random string; only used to sign SearXNG's own cookies.
SEARXNG_SECRET=fake-random-1
# Setting this makes SearXNG the \`web_search\` backend unless app.config.yaml
# \`search.backend\` picks another. Models with built-in search use theirs.
SEARXNG_URL=http://localhost:8080
# Paid backends, used when \`search.backend\` names them (keys stay here, not in
# the YAML). Without a key the backend is simply unavailable.
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# --- File storage (app.config.yaml \`storage\`) ---
# Only for \`driver: s3\` (S3, R2, MinIO). The local volume needs nothing.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Tooling ---
# Port Playwright serves the production build on for E2E runs.
E2E_PORT=3100
# Set to 1 to serve the component galleries under /dev/*. Unset, they 404.
# Checked per request, so one build serves both.
ENABLE_DEV_ROUTES=

# --- Secrets at rest (D24) ---
# Seals provider keys, MCP header secrets and MCP OAuth tokens (AES-256-GCM).
# 32 random bytes, base64 or hex: \`openssl rand -base64 32\`. Required in
# production (NODE_ENV=production): without it those features turn off.
# Elsewhere an insecure development key stands in, with a warning.
ENCRYPTION_KEY=
# To rotate: move the old key here (comma-separated for several) and set a new
# ENCRYPTION_KEY. Old secrets still open and are resealed when next written.
ENCRYPTION_KEY_PREVIOUS=

# --- Docker sandboxes (\`bun dev\` starts the runner when Docker is running) ---
# Shared secret between web and sandbox-runner; the runner refuses every call
# without it. Any long random string, e.g. \`openssl rand -hex 32\`.
SANDBOX_RUNNER_TOKEN=
SANDBOX_RUNNER_URL=http://localhost:7070
# auto (gVisor if the host has it, else runc with a warning) | runsc | runc
SANDBOX_RUNTIME=auto
# Where sandboxes may connect is \`sandbox.egress\` in app.config.yaml. Set this
# (open | allowlist | none) only to override its mode for one deployment.
SANDBOX_EGRESS=
# The runner's container name; change it to run a second checkout's runner.
SANDBOX_RUNNER_CONTAINER=sandbox-runner
SANDBOX_IMAGE=node:24-bookworm-slim
# Previews are served from their own origin, never the app's.
SANDBOX_PREVIEW_URL=http://{id}-{port}.sandbox.localhost:7071
SANDBOX_RUNNER_PORT=7070
SANDBOX_PREVIEW_PORT=7071

# --- Artifact previews (\`bun dev\`, or the optional \`artifacts\` compose profile) ---
# Where the artifact runtime (apps/artifacts) is served: its own origin, never
# the app's (D24). Unset: HTML and SVG preview in a srcdoc frame, and React and
# Mermaid show their source only.
ARTIFACTS_ORIGIN=http://artifacts.localhost:3910
ARTIFACTS_PORT=3910
# App origins allowed to embed the runtime, comma-separated. Unset: any
# localhost port, for development. Set it to the app's public origin in production.
ARTIFACTS_APP_ORIGINS=

# Voice (docs/voice.md): \`docker compose --profile voice up -d\`, then point
# app.config.yaml's \`voice:\` at these. Unset, voice is off.
# VOICE_STT_URL=http://localhost:8000/v1
# VOICE_TTS_URL=http://localhost:8880/v1
# VOICE_STT_PORT=8000
# VOICE_TTS_PORT=8880

# --- Docker builds on a corporate network (docs/self-hosting.md) ---
# Set these in the shell, not here: this file is also the web container's
# environment. BUILD_CA_PEM is the text of a root CA that intercepts TLS, and
# BUILD_NPMRC the text of an .npmrc for a company npm mirror. \`bun install\`
# reads both as build secrets; neither is stored in an image.
#   BUILD_CA_PEM="$(cat ~/corporate-ca.pem)" docker compose up -d --build
"
`;

exports[`first run: local dev on PGlite with Ollama and every service > writes app.config.yaml, which the app accepts 1`] = `
"# Instance configuration (PLAN.md §9, D18). Copy to app.config.yaml, or point
# CONFIG_PATH at your copy. Every section is optional: with no file at all the
# app boots on defaults and falls back to a local Ollama.
#
# Secrets come from the environment as \${NAME} (or \${NAME:-fallback}); never
# write them here. A value that is just \${NAME} with NAME unset counts as
# absent, so a missing key disables that provider instead of failing boot.
# Changes apply on restart. Invalid config fails at boot with the path and
# reason for every problem.
version: 1

# The product name lives only here (and in the root package.json and image
# names); everything else reads it at runtime.
brand:
  name: Acme Chat
  appId: dev.example.app
  urlScheme: example
  # SVG, PNG or JPEG, relative to this file. One SVG is enough: drawn in
  # currentColor it follows the theme; with its own colours it's shown as is.
  logo: ./brand/logo.svg
  # logoDark: ./brand/logo-dark.svg   # a multi-colour logo's dark-theme version
  # favicon: ./brand/icon.svg         # the square mark for tab and home-screen icons
  # iconBackground: black             # behind the mark on home-screen icons

auth:
  signup: domain # open | invite | domain | sso; the first user is always admin
  domains: [ example.com, example.org ]
  oidc: [] # SSO: [{ id, name, issuer, clientId, clientSecret }]
  # social:
  #   github: { clientId: \${GITHUB_CLIENT_ID}, clientSecret: \${GITHUB_CLIENT_SECRET} }
  # Sign in with Microsoft (Entra ID). Off until both credentials are set;
  # see docs/self-hosting.md, "Sign in with Microsoft (Entra ID)".
  # microsoft:
  #   clientId: \${MICROSOFT_CLIENT_ID}
  #   clientSecret: \${MICROSOFT_CLIENT_SECRET}
  #   tenantId: organizations   # common | organizations | consumers | <tenant GUID or domain>
  #   allowedDomains: []        # e.g. [contoso.com]; empty allows any. A filter, not a security boundary
  #   allowedTenants: []        # tenant GUIDs (the \`tid\` claim); empty allows any
  #   autoProvision: false      # true: allowed users get an account without an invite; needs a tenant GUID or allowedTenants
  #   name: Microsoft           # the button reads "Continue with <name>"
  #   photo: { enabled: true, maxBytes: 1048576 }

providers:
  ollama: { type: openai-compatible, baseURL: "\${OLLAMA_BASE_URL:-http://localhost:11434/v1}" }

models:
  aliases:
    strong: ollama:llama3.2
  default: strong
  auto: { enabled: false, cheap: null, strong: null }
  # Image generation (\`generate_image\`): its own list, never in the chat
  # picker. \`discover: true\` adds a discovering provider's image models (the
  # gateway's \`type: image\`). Calls ask first unless \`approval: auto\`.
  # image: { default: openai:gpt-image-1, discover: false, approval: ask }
  # Usage is priced and the picker rated from the repo's model catalogue
  # (packages/config/src/catalog: models.dev list prices, Gateway speed, a
  # curated intelligence list). \`prices\` and \`ratings\` here override it.
  # Prices are micro-USD per million tokens; per-image prices sit beside them:
  # prices: { "openai:gpt-image-1": { imageMicros: 40000 } }
  # ratings: { strong: { speed: 3, intelligence: 5 } }
  # One line under each model in the picker, by alias or provider:model ref.
  # Beats what a provider's catalog says; \`auto\` has its own.
  descriptions:
    strong: Hard problems and long documents
  # Defaults to auto.cheap. Set to false to name chats from their first message.
  # conversationTitleModel: fast

  # Costs are kept in US dollars; this only changes how they're shown, at a
  # fixed rate you set (nothing is fetched). Budgets are typed in this currency.
  # usage:
  #   currency: { code: AUD, perUsd: 1.52 }

  # Instance-wide limits; each org chooses within them in the admin UI.
policies:
  chatContext: [ personal, team, org ]
  auditPolicy: allowed # allowed | forbidden
  personalKeyFallback: allowed
  instanceKeys: { personal: true, team: false, org: false }
  publishGate: { default: informational, allowed: [ informational, no-regressions ] }
  sampledScoring: allowed
  persistClientCache: allowed # forbidden: no client keeps its query cache on disk (D28)

decider:
  adapter: llm-fallback # llm-fallback | jev | none
  model: null
  thresholds: { autoRouteStrong: 0.6, needsRetrieval: 0.5, riskAsk: 0.3, riskBlock: 0.7 }

search:
  native: true # use the provider's own web search when the model has it
  backend: searxng # none | searxng | brave | tavily | exa
  searxng: { url: "\${SEARXNG_URL:-http://localhost:8080}" }
  # brave: { apiKey: "\${BRAVE_API_KEY}" }

sandbox:
  default: just-bash # just-bash | docker | e2b | vercel | microsandbox | none
  docker:
    runnerUrl: "\${SANDBOX_RUNNER_URL:-http://sandbox-runner:7070}"
    token: "\${SANDBOX_RUNNER_TOKEN}"
    runtime: runsc # gVisor; the runner warns and falls back to runc if it's missing
    limits: { cpu: 2, memoryMb: 2048, diskMb: 10240 }
  # Where sandboxes may connect: open (anywhere) | allowlist (only \`allow\`,
  # through the runner's proxy) | none. SANDBOX_EGRESS overrides \`mode\`.
  # \`allow\` takes hostnames, or \`*.example.com\` for any subdomain.
  egress:
    mode: open
    allow:
      - registry.npmjs.org
      - registry.yarnpkg.com
      - pypi.org
      - files.pythonhosted.org
      - github.com
      - api.github.com
      - codeload.github.com
      - objects.githubusercontent.com
      - raw.githubusercontent.com
      - release-assets.githubusercontent.com

# ./.data is git-ignored; in the Docker image it's the \`web-data\` volume.
storage: { driver: local, path: ./.data/files }
# storage: { driver: s3, bucket: files, endpoint: "\${S3_ENDPOINT}", accessKeyId: "\${S3_ACCESS_KEY_ID}", secretAccessKey: "\${S3_SECRET_ACCESS_KEY}" }

embeddings: { model: null }

# Read at build time, not boot (D19): rebuild after changing it. This block is
# the only place to choose; ICON_* in the environment is ignored while it's here.
icons: { set: lucide } # e.g. { set: material, style: rounded, weight: 400, fill: false }

# Interface fonts, from npm (nothing is downloaded). Compiled in like icons:
# only the chosen pair ships; \`bun dev\` picks a change up on restart.
# sans: geist | inter | open-sans | ibm-plex-sans | figtree | manrope
# mono: geist-mono | jetbrains-mono
fonts: { sans: geist, mono: geist-mono }

observability: { otlp: null, recordContent: false } # otlp: { endpoint: "\${OTEL_EXPORTER_OTLP_ENDPOINT}" }; recordContent puts prompts on spans
# userTracesUrl: "https://cloud.langfuse.com/project/<project-id>/users/{userId}"   # admins get a link from Settings → Usage

limits:
  requestsPerMinute: 60
  uploadMaxMb: 25
  memoryMaxChars: 8000
  # budgets: { user: { period: month, limitMicros: 20000000 } }   # 20 USD

  # Scheduled tasks run unattended and spend tokens with nobody watching, so
  # these guardrails are on by default (all optional; these are the defaults).
  # schedules:
  #   minIntervalMinutes: 60      # the shortest gap a recurring task may have
  #   maxRunsPerUserPerDay: 24    # rolling 24 hours, "Run now" included
  #   runStepBudget: 8            # agent steps per run
  #   runTokenBudget: 20000       # input + output tokens per run
  #   defaultModel: fast          # for tasks on ordinary chats (null: \`fast\` if aliased)

features:
  importers: true
  publicLinks: false
  chatModes: false # the composer's Chat / Code switch; off, every chat gets the sandbox tools

# Connectors (184): MCP servers you offer every user. Each user sees them in
# Settings > Connectors and can turn them on or off, unless you say otherwise:
#   default: on | off | required   on (the default) or off until a user flips it;
#                                  required is always on and can't be turned off
#   allowUserOverride: false       fixes the toggle at \`default\` (shown locked)
#   reason: "..."                  shown next to a locked toggle
#   tools: { allow: [...], deny: [...], required: [...] }   by the server's own tool names;
#     denied tools never reach users; required ones stay on (users switch the rest, 188)
# Secrets go in \${ENV} references, never in this file. A header or env value
# whose variable is unset marks only that server "needs setup"; boot carries on.
# stdio servers run in the desktop app only; the web app lists them as such.
mcp:
  servers: []
  # servers:
  #   # A remote (Streamable HTTP) server with a token from the environment.
  #   - name: docs                      # tool prefix: docs__search, ...
  #     title: Company docs
  #     description: Search the handbook and runbooks
  #     url: https://mcp.example.com/mcp
  #     headers: { Authorization: "\${DOCS_MCP_AUTHORIZATION}" }   # e.g. "Bearer ..."
  #     tools: { deny: [delete_page] }
  #   # Each user signs in with their own account (per-user OAuth tokens).
  #   - name: tracker
  #     url: https://mcp.tracker.example.com/mcp
  #     auth: { type: oauth, scopes: [read] }
  #     default: off
  #   # Always on for everyone; users see why it's locked.
  #   - name: audit
  #     title: Audit log
  #     url: "\${AUDIT_MCP_URL:-http://audit-mcp:8080/mcp}"
  #     default: required
  #     reason: Required by IT for compliance
  #   # A local stdio server, for the desktop app.
  #   - name: files
  #     transport: stdio
  #     command: npx
  #     args: ["-y", "@modelcontextprotocol/server-filesystem", "~/Documents"]
  #     default: off
  # Whether users may add their own servers in the MCP Library.
  userServers:
    allowed: true
    transports: [ http, sse ]
    hosts: [] # e.g. ["*.example.com"]; empty means any public host

# What the UI calls a feature, and where it lives (docs/self-hosting.md,
# "Renaming features for your fork"). Code, the database and the API keep
# the id (\`mcp\`); only the words and the settings address change.
# terms:
#   mcp:
#     label: MCP servers      # default; plural, for headings and menus
#     singular: MCP server    # one of them, used mid-sentence
#     slug: mcp               # → /settings/mcp (old addresses redirect here)
#     locales:                # for languages that inflect
#       de: { label: MCP-Server, singular: MCP-Server }

artifacts:
  origin: null # a separate origin for artifacts and previews, e.g. https://artifacts.example.com
  kinds:
    # The kinds people and the model may make. A kind left out isn't offered
    # (the model's tools, "Make something new", the kind filters); artifacts
    # of it still open, read only. Off by default: markdown (documents stand
    # in), html and react (sites stand in) and code (Code mode). Add any of
    # them back to this list to turn it on.
    enabled: [ document, site, presentation, spreadsheet, diagram, mermaid, svg, image ]
    site:
      # Sites (125): small static websites, published to a link on the runtime's origin
      enabled: true
      # stack: deprecated and ignored (163). Pages are TSX built from
      # @workspace/site-ui, or plain HTML; there are no stacks to pick.
      # The public origins sites may load fonts, styles, scripts and images
      # from; their CSP blocks everything else. https only; https://*.host
      # covers subdomains. These are the defaults.
      allowedOrigins:
        - https://fonts.googleapis.com
        - https://fonts.gstatic.com
        - https://cdnjs.cloudflare.com
        - https://cdn.jsdelivr.net

# Voice conversations (docs/voice.md). Off until configured: no URLs (local)
# or no key (openai) and the call button stays hidden.
#   local:  \`docker compose --profile voice up -d\` runs Whisper (Speaches) and
#           Kokoro; both stay on this machine.
#   openai: OpenAI's audio API and, for speech to speech, Realtime. The key
#           falls back to providers.openai.apiKey.
voice:
  provider: local # local | openai
  stt: { url: "\${VOICE_STT_URL}", model: Systran/faster-whisper-base.en }
  tts: { url: "\${VOICE_TTS_URL}", model: kokoro, voice: af_heart }
  # openai: { apiKey: "\${OPENAI_API_KEY}", sttModel: gpt-4o-mini-transcribe, ttsModel: gpt-4o-mini-tts, voice: alloy, realtimeModel: gpt-realtime }
  maxUploadMb: 10
"
`;

exports[`first run: local dev on PGlite with Ollama and every service > writes docker-compose.override.yml only for Docker 1`] = `undefined`;

exports[`first run: the 026 demo (Docker, Anthropic, Docker sandboxes, Material) > writes .env 1`] = `
"# Copy to .env and adjust. Every variable is optional: the web app boots with an
# empty .env and features that need a missing value degrade instead of failing.

# --- Database (docker-compose \`postgres\` service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_PORT=5432
# Used by the app and migrations. Leave it empty (or unset) and the server
# runs on an embedded database (PGlite) in \`./.data/pglite\`, migrated at boot:
# fine for \`bun dev\` and trying things out, one process only, not for
# deployments.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app

# --- Auth (Better Auth) ---
# Signs sessions and encrypts tokens. Generate with \`openssl rand -base64 32\`.
# Unset in development: a fixed dev-only secret is used, with a warning.
# Unset in production: sign-in stays off rather than use a known key.
# Also keys the local file store's signed download links (derived, not reused).
BETTER_AUTH_SECRET=
# The public origin (https://chat.example.com); inferred per request when unset.
# Sign-in works from this origin only; when it's localhost, 127.0.0.1 or [::1],
# from the other two on the same scheme and port as well.
BETTER_AUTH_URL=http://localhost:3000
# Other origins sign-in accepts, exactly, comma-separated: another hostname for
# the same server, or a LAN address (\`https://chat.example.org,
# http://192.168.1.20:3000\`). No paths or wildcards; entries that aren't an
# origin are ignored, with a warning at start. Use this rather than Better
# Auth's own BETTER_AUTH_TRUSTED_ORIGINS, which it applies unchecked.
# See docs/self-hosting.md, "Behind a proxy".
TRUSTED_ORIGINS=
# Social sign-in appears only when both halves of a pair are set (or when
# app.config.yaml \`auth.social\` configures the provider).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Sign in with Microsoft (Entra ID): read only through app.config.yaml
# \`auth.microsoft\` (\`clientId: \${MICROSOFT_CLIENT_ID}\`); see docs/self-hosting.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Proxies in front of the app whose X-Forwarded-For entries are believed: IP
# addresses and CIDR ranges, comma-separated (for example
# \`127.0.0.1, ::1, 172.16.0.0/12\` for a proxy on the host or a Docker network).
# Sign-in rate limits and the address kept on each session come from the
# first hop, read from the right, that isn't one of these. Unset, only the
# last hop counts. See docs/self-hosting.md, "Behind a proxy".
TRUSTED_PROXIES=

# --- Web search (optional \`search\` compose profile) ---
SEARXNG_PORT=8080
# Any long random string; only used to sign SearXNG's own cookies.
SEARXNG_SECRET=dev-only-change-me
# Setting this makes SearXNG the \`web_search\` backend unless app.config.yaml
# \`search.backend\` picks another. Models with built-in search use theirs.
SEARXNG_URL=
# Paid backends, used when \`search.backend\` names them (keys stay here, not in
# the YAML). Without a key the backend is simply unavailable.
BRAVE_API_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# --- File storage (app.config.yaml \`storage\`) ---
# Only for \`driver: s3\` (S3, R2, MinIO). The local volume needs nothing.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Tooling ---
# Port Playwright serves the production build on for E2E runs.
E2E_PORT=3100
# Set to 1 to serve the component galleries under /dev/*. Unset, they 404.
# Checked per request, so one build serves both.
ENABLE_DEV_ROUTES=

# --- Secrets at rest (D24) ---
# Seals provider keys, MCP header secrets and MCP OAuth tokens (AES-256-GCM).
# 32 random bytes, base64 or hex: \`openssl rand -base64 32\`. Required in
# production (NODE_ENV=production): without it those features turn off.
# Elsewhere an insecure development key stands in, with a warning.
ENCRYPTION_KEY=
# To rotate: move the old key here (comma-separated for several) and set a new
# ENCRYPTION_KEY. Old secrets still open and are resealed when next written.
ENCRYPTION_KEY_PREVIOUS=

# --- Docker sandboxes (\`bun dev\` starts the runner when Docker is running) ---
# Shared secret between web and sandbox-runner; the runner refuses every call
# without it. Any long random string, e.g. \`openssl rand -hex 32\`.
SANDBOX_RUNNER_TOKEN=fake-random-1
SANDBOX_RUNNER_URL=http://localhost:7070
# auto (gVisor if the host has it, else runc with a warning) | runsc | runc
SANDBOX_RUNTIME=auto
# Where sandboxes may connect is \`sandbox.egress\` in app.config.yaml. Set this
# (open | allowlist | none) only to override its mode for one deployment.
SANDBOX_EGRESS=
# The runner's container name; change it to run a second checkout's runner.
SANDBOX_RUNNER_CONTAINER=sandbox-runner
SANDBOX_IMAGE=node:24-bookworm-slim
# Previews are served from their own origin, never the app's.
SANDBOX_PREVIEW_URL=http://{id}-{port}.sandbox.localhost:7071
SANDBOX_RUNNER_PORT=7070
SANDBOX_PREVIEW_PORT=7071

# --- Artifact previews (\`bun dev\`, or the optional \`artifacts\` compose profile) ---
# Where the artifact runtime (apps/artifacts) is served: its own origin, never
# the app's (D24). Unset: HTML and SVG preview in a srcdoc frame, and React and
# Mermaid show their source only.
ARTIFACTS_ORIGIN=
ARTIFACTS_PORT=3910
# App origins allowed to embed the runtime, comma-separated. Unset: any
# localhost port, for development. Set it to the app's public origin in production.
ARTIFACTS_APP_ORIGINS=

# Voice (docs/voice.md): \`docker compose --profile voice up -d\`, then point
# app.config.yaml's \`voice:\` at these. Unset, voice is off.
# VOICE_STT_URL=http://localhost:8000/v1
# VOICE_TTS_URL=http://localhost:8880/v1
# VOICE_STT_PORT=8000
# VOICE_TTS_PORT=8880

# --- Docker builds on a corporate network (docs/self-hosting.md) ---
# Set these in the shell, not here: this file is also the web container's
# environment. BUILD_CA_PEM is the text of a root CA that intercepts TLS, and
# BUILD_NPMRC the text of an .npmrc for a company npm mirror. \`bun install\`
# reads both as build secrets; neither is stored in an image.
#   BUILD_CA_PEM="$(cat ~/corporate-ca.pem)" docker compose up -d --build

# --- Set by \`bun run setup\` ---
ANTHROPIC_API_KEY=fake-anthropic-key-placeholder
"
`;

exports[`first run: the 026 demo (Docker, Anthropic, Docker sandboxes, Material) > writes app.config.yaml, which the app accepts 1`] = `
"# Instance configuration (PLAN.md §9, D18). Copy to app.config.yaml, or point
# CONFIG_PATH at your copy. Every section is optional: with no file at all the
# app boots on defaults and falls back to a local Ollama.
#
# Secrets come from the environment as \${NAME} (or \${NAME:-fallback}); never
# write them here. A value that is just \${NAME} with NAME unset counts as
# absent, so a missing key disables that provider instead of failing boot.
# Changes apply on restart. Invalid config fails at boot with the path and
# reason for every problem.
version: 1

# The product name lives only here (and in the root package.json and image
# names); everything else reads it at runtime.
brand:
  name: example
  appId: dev.example.app
  urlScheme: example
  # SVG, PNG or JPEG, relative to this file. One SVG is enough: drawn in
  # currentColor it follows the theme; with its own colours it's shown as is.
  logo: ./brand/logo.svg
  # logoDark: ./brand/logo-dark.svg   # a multi-colour logo's dark-theme version
  # favicon: ./brand/icon.svg         # the square mark for tab and home-screen icons
  # iconBackground: black             # behind the mark on home-screen icons

auth:
  signup: invite # open | invite | domain | sso; the first user is always admin
  domains: [] # for signup: domain, e.g. [example.com]
  oidc: [] # SSO: [{ id, name, issuer, clientId, clientSecret }]
  # social:
  #   github: { clientId: \${GITHUB_CLIENT_ID}, clientSecret: \${GITHUB_CLIENT_SECRET} }
  # Sign in with Microsoft (Entra ID). Off until both credentials are set;
  # see docs/self-hosting.md, "Sign in with Microsoft (Entra ID)".
  # microsoft:
  #   clientId: \${MICROSOFT_CLIENT_ID}
  #   clientSecret: \${MICROSOFT_CLIENT_SECRET}
  #   tenantId: organizations   # common | organizations | consumers | <tenant GUID or domain>
  #   allowedDomains: []        # e.g. [contoso.com]; empty allows any. A filter, not a security boundary
  #   allowedTenants: []        # tenant GUIDs (the \`tid\` claim); empty allows any
  #   autoProvision: false      # true: allowed users get an account without an invite; needs a tenant GUID or allowedTenants
  #   name: Microsoft           # the button reads "Continue with <name>"
  #   photo: { enabled: true, maxBytes: 1048576 }

providers:
  anthropic: { apiKey: "\${ANTHROPIC_API_KEY}" }

models:
  aliases:
    fast: anthropic:claude-haiku-4-5
    strong: anthropic:claude-opus-5-5
  default: strong
  auto: { enabled: true, cheap: fast, strong: strong }
  # Image generation (\`generate_image\`): its own list, never in the chat
  # picker. \`discover: true\` adds a discovering provider's image models (the
  # gateway's \`type: image\`). Calls ask first unless \`approval: auto\`.
  # image: { default: openai:gpt-image-1, discover: false, approval: ask }
  # Usage is priced and the picker rated from the repo's model catalogue
  # (packages/config/src/catalog: models.dev list prices, Gateway speed, a
  # curated intelligence list). \`prices\` and \`ratings\` here override it.
  # Prices are micro-USD per million tokens; per-image prices sit beside them:
  # prices: { "openai:gpt-image-1": { imageMicros: 40000 } }
  # ratings: { strong: { speed: 3, intelligence: 5 } }
  # One line under each model in the picker, by alias or provider:model ref.
  # Beats what a provider's catalog says; \`auto\` has its own.
  descriptions:
    fast: Quick everyday answers
    strong: Hard problems and long documents
  # Defaults to auto.cheap. Set to false to name chats from their first message.
  # conversationTitleModel: fast

  # Costs are kept in US dollars; this only changes how they're shown, at a
  # fixed rate you set (nothing is fetched). Budgets are typed in this currency.
  # usage:
  #   currency: { code: AUD, perUsd: 1.52 }

  # Instance-wide limits; each org chooses within them in the admin UI.
policies:
  chatContext: [ personal, team, org ]
  auditPolicy: allowed # allowed | forbidden
  personalKeyFallback: allowed
  instanceKeys: { personal: true, team: false, org: false }
  publishGate: { default: informational, allowed: [ informational, no-regressions ] }
  sampledScoring: allowed
  persistClientCache: allowed # forbidden: no client keeps its query cache on disk (D28)

decider:
  adapter: llm-fallback # llm-fallback | jev | none
  model: fast
  thresholds: { autoRouteStrong: 0.6, needsRetrieval: 0.5, riskAsk: 0.3, riskBlock: 0.7 }

search:
  native: true # use the provider's own web search when the model has it
  backend: none # none | searxng | brave | tavily | exa
  searxng: { url: "\${SEARXNG_URL:-http://localhost:8080}" }
  # brave: { apiKey: "\${BRAVE_API_KEY}" }

sandbox:
  default: docker # just-bash | docker | e2b | vercel | microsandbox | none
  docker:
    runnerUrl: "\${SANDBOX_RUNNER_URL:-http://sandbox-runner:7070}"
    token: "\${SANDBOX_RUNNER_TOKEN}"
    runtime: runsc # gVisor; the runner warns and falls back to runc if it's missing
    limits: { cpu: 2, memoryMb: 2048, diskMb: 10240 }
  # Where sandboxes may connect: open (anywhere) | allowlist (only \`allow\`,
  # through the runner's proxy) | none. SANDBOX_EGRESS overrides \`mode\`.
  # \`allow\` takes hostnames, or \`*.example.com\` for any subdomain.
  egress:
    mode: open
    allow:
      - registry.npmjs.org
      - registry.yarnpkg.com
      - pypi.org
      - files.pythonhosted.org
      - github.com
      - api.github.com
      - codeload.github.com
      - objects.githubusercontent.com
      - raw.githubusercontent.com
      - release-assets.githubusercontent.com

# ./.data is git-ignored; in the Docker image it's the \`web-data\` volume.
storage: { driver: local, path: ./.data/files }
# storage: { driver: s3, bucket: files, endpoint: "\${S3_ENDPOINT}", accessKeyId: "\${S3_ACCESS_KEY_ID}", secretAccessKey: "\${S3_SECRET_ACCESS_KEY}" }

embeddings: { model: null }

# Read at build time, not boot (D19): rebuild after changing it. This block is
# the only place to choose; ICON_* in the environment is ignored while it's here.
icons: { set: material, style: rounded } # e.g. { set: material, style: rounded, weight: 400, fill: false }

# Interface fonts, from npm (nothing is downloaded). Compiled in like icons:
# only the chosen pair ships; \`bun dev\` picks a change up on restart.
# sans: geist | inter | open-sans | ibm-plex-sans | figtree | manrope
# mono: geist-mono | jetbrains-mono
fonts: { sans: geist, mono: geist-mono }

observability: { otlp: null, recordContent: false } # otlp: { endpoint: "\${OTEL_EXPORTER_OTLP_ENDPOINT}" }; recordContent puts prompts on spans
# userTracesUrl: "https://cloud.langfuse.com/project/<project-id>/users/{userId}"   # admins get a link from Settings → Usage

limits:
  requestsPerMinute: 60
  uploadMaxMb: 25
  memoryMaxChars: 8000
  # budgets: { user: { period: month, limitMicros: 20000000 } }   # 20 USD

  # Scheduled tasks run unattended and spend tokens with nobody watching, so
  # these guardrails are on by default (all optional; these are the defaults).
  # schedules:
  #   minIntervalMinutes: 60      # the shortest gap a recurring task may have
  #   maxRunsPerUserPerDay: 24    # rolling 24 hours, "Run now" included
  #   runStepBudget: 8            # agent steps per run
  #   runTokenBudget: 20000       # input + output tokens per run
  #   defaultModel: fast          # for tasks on ordinary chats (null: \`fast\` if aliased)

features:
  importers: true
  publicLinks: false
  chatModes: false # the composer's Chat / Code switch; off, every chat gets the sandbox tools

# Connectors (184): MCP servers you offer every user. Each user sees them in
# Settings > Connectors and can turn them on or off, unless you say otherwise:
#   default: on | off | required   on (the default) or off until a user flips it;
#                                  required is always on and can't be turned off
#   allowUserOverride: false       fixes the toggle at \`default\` (shown locked)
#   reason: "..."                  shown next to a locked toggle
#   tools: { allow: [...], deny: [...], required: [...] }   by the server's own tool names;
#     denied tools never reach users; required ones stay on (users switch the rest, 188)
# Secrets go in \${ENV} references, never in this file. A header or env value
# whose variable is unset marks only that server "needs setup"; boot carries on.
# stdio servers run in the desktop app only; the web app lists them as such.
mcp:
  servers: []
  # servers:
  #   # A remote (Streamable HTTP) server with a token from the environment.
  #   - name: docs                      # tool prefix: docs__search, ...
  #     title: Company docs
  #     description: Search the handbook and runbooks
  #     url: https://mcp.example.com/mcp
  #     headers: { Authorization: "\${DOCS_MCP_AUTHORIZATION}" }   # e.g. "Bearer ..."
  #     tools: { deny: [delete_page] }
  #   # Each user signs in with their own account (per-user OAuth tokens).
  #   - name: tracker
  #     url: https://mcp.tracker.example.com/mcp
  #     auth: { type: oauth, scopes: [read] }
  #     default: off
  #   # Always on for everyone; users see why it's locked.
  #   - name: audit
  #     title: Audit log
  #     url: "\${AUDIT_MCP_URL:-http://audit-mcp:8080/mcp}"
  #     default: required
  #     reason: Required by IT for compliance
  #   # A local stdio server, for the desktop app.
  #   - name: files
  #     transport: stdio
  #     command: npx
  #     args: ["-y", "@modelcontextprotocol/server-filesystem", "~/Documents"]
  #     default: off
  # Whether users may add their own servers in the MCP Library.
  userServers:
    allowed: true
    transports: [ http, sse ]
    hosts: [] # e.g. ["*.example.com"]; empty means any public host

# What the UI calls a feature, and where it lives (docs/self-hosting.md,
# "Renaming features for your fork"). Code, the database and the API keep
# the id (\`mcp\`); only the words and the settings address change.
# terms:
#   mcp:
#     label: MCP servers      # default; plural, for headings and menus
#     singular: MCP server    # one of them, used mid-sentence
#     slug: mcp               # → /settings/mcp (old addresses redirect here)
#     locales:                # for languages that inflect
#       de: { label: MCP-Server, singular: MCP-Server }

artifacts:
  origin: null # a separate origin for artifacts and previews, e.g. https://artifacts.example.com
  kinds:
    # The kinds people and the model may make. A kind left out isn't offered
    # (the model's tools, "Make something new", the kind filters); artifacts
    # of it still open, read only. Off by default: markdown (documents stand
    # in), html and react (sites stand in) and code (Code mode). Add any of
    # them back to this list to turn it on.
    enabled: [ document, site, presentation, spreadsheet, diagram, mermaid, svg, image ]
    site:
      # Sites (125): small static websites, published to a link on the runtime's origin
      enabled: true
      # stack: deprecated and ignored (163). Pages are TSX built from
      # @workspace/site-ui, or plain HTML; there are no stacks to pick.
      # The public origins sites may load fonts, styles, scripts and images
      # from; their CSP blocks everything else. https only; https://*.host
      # covers subdomains. These are the defaults.
      allowedOrigins:
        - https://fonts.googleapis.com
        - https://fonts.gstatic.com
        - https://cdnjs.cloudflare.com
        - https://cdn.jsdelivr.net

# Voice conversations (docs/voice.md). Off until configured: no URLs (local)
# or no key (openai) and the call button stays hidden.
#   local:  \`docker compose --profile voice up -d\` runs Whisper (Speaches) and
#           Kokoro; both stay on this machine.
#   openai: OpenAI's audio API and, for speech to speech, Realtime. The key
#           falls back to providers.openai.apiKey.
voice:
  provider: local # local | openai
  stt: { url: "\${VOICE_STT_URL}", model: Systran/faster-whisper-base.en }
  tts: { url: "\${VOICE_TTS_URL}", model: kokoro, voice: af_heart }
  # openai: { apiKey: "\${OPENAI_API_KEY}", sttModel: gpt-4o-mini-transcribe, ttsModel: gpt-4o-mini-tts, voice: alloy, realtimeModel: gpt-realtime }
  maxUploadMb: 10
"
`;

exports[`first run: the 026 demo (Docker, Anthropic, Docker sandboxes, Material) > writes docker-compose.override.yml only for Docker 1`] = `
"# Written by \`bun run setup\`: mounts app.config.yaml into \`web\`
# (docs/self-hosting.md). Your own additions are kept on a re-run.

services:
  web:
    environment:
      CONFIG_PATH: /config/app.config.yaml
    volumes:
      - ./app.config.yaml:/config/app.config.yaml:ro
"
`;
