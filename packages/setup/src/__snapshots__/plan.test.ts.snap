  default: strong
  auto: { enabled: true, cheap: fast, strong: strong }

# Instance-wide limits; each org chooses within them in the admin UI.
policies:
  chatContext: [ personal, team, org ]
  auditPolicy: allowed # allowed | forbidden
  personalKeyFallback: allowed
  instanceKeys: { personal: true, team: false, org: false }
  publishGate: { default: informational, allowed: [ informational, no-regressions ] }
  sampledScoring: allowed
  persistClientCache: allowed # forbidden: no client keeps its query cache on disk (D28)

decider:
  adapter: llm-fallback # llm-fallback | jev | none
  model: fast
  thresholds: { autoRouteStrong: 0.6, needsRetrieval: 0.5, riskAsk: 0.3, riskBlock: 0.7 }

search:
  native: true # use the provider's own web search when the model has it
  backend: none # none | searxng | brave | tavily | exa
  searxng: { url: "\${SEARXNG_URL:-http://localhost:8080}" }
  # brave: { apiKey: "\${BRAVE_API_KEY}" }

sandbox:
  default: docker # just-bash | docker | e2b | vercel | microsandbox | none
  docker:
    runnerUrl: "\${SANDBOX_RUNNER_URL:-http://sandbox-runner:7070}"
    token: "\${SANDBOX_RUNNER_TOKEN}"
    runtime: runsc # gVisor; the runner warns and falls back to runc if it's missing
    limits: { cpu: 2, memoryMb: 2048, diskMb: 10240 }

# ./.data is git-ignored; in the Docker image it's the \`web-data\` volume.
storage: { driver: local, path: ./.data/files }
# storage: { driver: s3, bucket: files, endpoint: "\${S3_ENDPOINT}", accessKeyId: "\${S3_ACCESS_KEY_ID}", secretAccessKey: "\${S3_SECRET_ACCESS_KEY}" }

embeddings: { model: null }

# Read at build time, not boot (D19): rebuild after changing it. ICON_SET,
# ICON_STYLE, ICON_WEIGHT and ICON_FILL override it (a Docker image's build args).
icons: { set: material, style: rounded } # e.g. { set: material, style: rounded, weight: 400, fill: false }

observability: { otlp: null, recordContent: false } # otlp: { endpoint: "\${OTEL_EXPORTER_OTLP_ENDPOINT}" }; recordContent puts prompts on spans

limits:
  requestsPerMinute: 60
  uploadMaxMb: 25
  memoryMaxChars: 8000
  # budgets: { user: { period: month, limitMicros: 20000000 } }   # 20 USD

features:
  importers: true
  publicLinks: false

mcp:
  servers: [] # instance-wide: [{ name, url, transport: http }]

artifacts:
  origin: null # a separate origin for artifacts and previews, e.g. https://artifacts.example.com
"
`;

exports[`first run: the 026 demo (Docker, Anthropic, Docker sandboxes, Material) > writes docker-compose.override.yml only for Docker 1`] = `
"# Written by \`bun run setup\`: mounts app.config.yaml into \`web\`
# (docs/self-hosting.md). Your own additions are kept on a re-run.

services:
  web:
    environment:
      CONFIG_PATH: /config/app.config.yaml
    volumes:
      - ./app.config.yaml:/config/app.config.yaml:ro
"
`;
