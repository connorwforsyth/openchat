{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    // Run as TypeScript source by bun and Vitest, both of which resolve like
    // a bundler (and so do the workspace packages it imports).
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  },
  "include": ["."],
  "exclude": ["node_modules", "dist"]
}
