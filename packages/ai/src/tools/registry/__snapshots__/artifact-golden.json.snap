                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "artifactVersion id (UUIDv7)"
                  }
                },
                "required": [
                  "artifactId",
                  "kind",
                  "title",
                  "versionId"
                ],
                "additionalProperties": false
              },
              "status": {
                "type": "string",
                "const": "saved"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "artifact",
              "status",
              "version"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "problems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "const": "invalid"
              }
            },
            "required": [
              "problems",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "description": "artifact id (UUIDv7)"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "code",
                        "html",
                        "react",
                        "markdown",
                        "svg",
                        "mermaid",
                        "site",
                        "document",
                        "image",
                        "presentation",
                        "spreadsheet",
                        "diagram"
                      ]
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "artifactId",
                    "kind",
                    "title"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "string",
                "const": "not_found"
              }
            },
            "required": [
              "artifacts",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "const": "unavailable"
              }
            },
            "required": [
              "message",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
