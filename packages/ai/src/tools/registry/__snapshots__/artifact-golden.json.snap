{
  "definitions": [
    {
      "approval": "ask",
      "capability": "artifacts",
      "name": "create_artifact"
    },
    {
      "approval": "ask",
      "capability": "artifacts",
      "name": "update_artifact"
    }
  ],
  "kinds": [
    "code",
    "html",
    "react",
    "markdown",
    "svg",
    "mermaid",
    "site"
  ],
  "prompt": {
    "composed": {
      "sections": [],
      "text": ""
    },
    "fragment": {
      "source": "fragments/artifacts.md",
      "text": ""
    }
  },
  "tools": [
    {
      "customModelOutput": true,
      "description": "Create an artifact: a self-contained piece of work the user will want to keep, reuse or see rendered (a document, a web page, a React component, an SVG image, a Mermaid diagram or a code file). It opens beside the chat instead of filling the reply. Use it for substantial content; keep short snippets and explanations in the reply.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400000,
            "description": "The artifact's complete content, with no surrounding code fence."
          },
          "language": {
            "description": "For type \"code\": the language, as a code fence names it (ts, python, sql).",
            "type": "string",
            "pattern": "^[\\w+-]{1,32}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "A short title the user will recognise it by."
          },
          "type": {
            "type": "string",
            "enum": [
              "code",
              "html",
              "react",
              "markdown",
              "svg",
              "mermaid",
              "site"
            ],
            "description": "html: one complete HTML document. react: one file with a default-exported component. svg: one <svg> element. mermaid: diagram source. markdown: a document. code: a file in any language. site: a small website of several files, as JSON (see the Sites instructions)."
          }
        },
        "required": [
          "content",
          "title",
          "type"
        ],
        "additionalProperties": false
      },
      "name": "create_artifact",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "artifact id (UUIDv7)"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "code",
                      "html",
                      "react",
                      "markdown",
                      "svg",
                      "mermaid",
                      "site"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "versionId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "artifactVersion id (UUIDv7)"
                  }
                },
                "required": [
                  "artifactId",
                  "kind",
                  "title",
                  "versionId"
                ],
                "additionalProperties": false
              },
              "status": {
                "type": "string",
                "const": "saved"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "artifact",
              "status",
              "version"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "problems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "const": "invalid"
              }
            },
            "required": [
              "problems",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "description": "artifact id (UUIDv7)"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "code",
                        "html",
                        "react",
                        "markdown",
                        "svg",
                        "mermaid",
                        "site"
                      ]
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "artifactId",
                    "kind",
                    "title"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "string",
                "const": "not_found"
              }
            },
            "required": [
              "artifacts",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "const": "unavailable"
              }
            },
            "required": [
              "message",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "customModelOutput": true,
      "description": "Replace an artifact's content, saved as its next version; earlier versions are kept. Pass the complete new content, not a diff.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The artifactId create_artifact returned."
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400000,
            "description": "The artifact's complete content, with no surrounding code fence."
          },
          "language": {
            "description": "For type \"code\": the language, as a code fence names it (ts, python, sql).",
            "type": "string",
            "pattern": "^[\\w+-]{1,32}$"
          },
          "title": {
            "description": "A new title; leave out to keep the current one.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "artifactId",
          "content"
        ],
        "additionalProperties": false
      },
