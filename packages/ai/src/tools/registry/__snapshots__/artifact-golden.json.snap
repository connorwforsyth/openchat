{
  "definitions": [
    {
      "approval": "ask",
      "capability": "artifacts",
      "name": "create_artifact"
    },
    {
      "approval": "ask",
      "capability": "artifacts",
      "name": "update_artifact"
    }
  ],
  "kinds": [
    "code",
    "html",
    "react",
    "markdown",
    "svg",
    "mermaid",
    "site",
    "document",
    "spreadsheet"
  ],
  "prompt": {
    "composed": {
      "sections": [],
      "text": ""
    },
    "fragment": {
      "source": "fragments/artifacts.md",
      "text": ""
    }
  },
  "tools": [
    {
      "customModelOutput": true,
      "description": "Create an artifact: a self-contained piece of work the user will want to keep, reuse or see rendered (a document, a web page, a React component, an SVG image, a Mermaid diagram or a code file). It opens beside the chat instead of filling the reply. Use it for substantial content; keep short snippets and explanations in the reply.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400000,
            "description": "The artifact's complete content, with no surrounding code fence."
          },
          "language": {
            "description": "For type \"code\": the language, as a code fence names it (ts, python, sql).",
            "type": "string",
            "pattern": "^[\\w+-]{1,32}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "A short title the user will recognise it by."
          },
          "type": {
            "type": "string",
            "enum": [
              "code",
              "html",
              "react",
              "markdown",
              "svg",
              "mermaid",
              "site",
              "document",
              "spreadsheet"
            ],
            "description": "document: a rich-text document the user can edit and export, written in Markdown (prefer it for reports, plans and notes). html: one complete HTML document. react: one file with a default-exported component. svg: one <svg> element. mermaid: diagram source. markdown: Markdown text that is only read. code: a file in any language. site: a small website of several files, as JSON (see the Sites instructions). spreadsheet: sheets of values and formulas, one Markdown table per sheet (see the Spreadsheets instructions)."
          }
        },
        "required": [
          "content",
          "title",
          "type"
        ],
        "additionalProperties": false
      },
      "name": "create_artifact",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "artifact id (UUIDv7)"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "code",
                      "html",
                      "react",
                      "markdown",
                      "svg",
                      "mermaid",
                      "site",
                      "document",
                      "image",
                      "presentation",
                      "spreadsheet",
                      "diagram"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "versionId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "artifactVersion id (UUIDv7)"
                  }
                },
                "required": [
                  "artifactId",
                  "kind",
                  "title",
                  "versionId"
                ],
                "additionalProperties": false
              },
              "status": {
                "type": "string",
                "const": "saved"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "artifact",
              "status",
              "version"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "problems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "const": "invalid"
              }
            },
            "required": [
              "problems",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "description": "artifact id (UUIDv7)"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "code",
                        "html",
                        "react",
                        "markdown",
                        "svg",
                        "mermaid",
                        "site",
                        "document",
                        "image",
                        "presentation",
                        "spreadsheet",
                        "diagram"
                      ]
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "artifactId",
                    "kind",
                    "title"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "string",
                "const": "not_found"
              }
            },
            "required": [
              "artifacts",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "const": "unavailable"
              }
            },
            "required": [
              "message",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "customModelOutput": true,
      "description": "Save an artifact's next version; earlier versions are kept. Pass the complete new content, not a diff, or, for a document or spreadsheet, an edit of one part.",
      "inputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "artifactId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "The artifactId create_artifact returned."
          },
          "content": {
            "description": "The artifact's complete new content, with no surrounding code fence. Leave out when you send an edit.",
            "type": "string",
            "minLength": 1,
            "maxLength": 400000
          },
          "edit": {
            "type": "object",
            "properties": {
              "content": {
                "description": "Markdown for replace_section and insert: the new section body (start it with a heading to replace the heading too) or the blocks to insert.",
                "type": "string",
                "maxLength": 400000
              },
              "fmt": {
                "description": "Spreadsheet set_range and set_formula: a number format for the cells, as Excel writes one (\"0.00\", \"#,##0\", \"0%\").",
                "type": "string",
                "maxLength": 64
              },
              "formula": {
                "description": "Spreadsheet set_formula: the formula, with or without its leading \"=\".",
                "type": "string",
                "maxLength": 2000
              },
              "heading": {
                "description": "The section's heading text, as it reads (without #s). insert without one adds at the end of the document.",
                "type": "string",
                "maxLength": 300
              },
              "name": {
                "description": "Spreadsheet add_sheet: the new sheet's name. rename_sheet: the sheet's new name.",
                "type": "string",
                "maxLength": 64
              },
              "operation": {
                "type": "string",
                "enum": [
                  "delete_section",
                  "insert",
                  "replace_section",
                  "add_sheet",
                  "delete_range",
                  "rename_sheet",
                  "set_formula",
                  "set_range"
                ],
                "description": "Document: replace_section (the section under a heading, up to the next heading of the same or a higher level), insert (blocks at a section's start or end, or the document's end), delete_section (a heading and its section). Spreadsheet: set_range, set_formula, delete_range, add_sheet, rename_sheet."
              },
              "position": {
                "description": "For insert: where in the section. section_end by default.",
                "type": "string",
                "enum": [
                  "section_end",
                  "section_start"
                ]
              },
              "range": {
                "description": "Spreadsheet set_range, set_formula and delete_range: a cell (\"B2\") or a range (\"B2:D5\").",
                "type": "string",
                "maxLength": 32
              },
              "sheet": {
                "description": "Spreadsheet: the sheet the edit acts on; the first sheet when left out.",
                "type": "string",
                "maxLength": 64
              },
              "values": {
                "description": "Spreadsheet set_range: rows of cells from the range's top-left. Numbers, TRUE/FALSE, text, \"=FORMULA\", or null to clear.",
                "maxItems": 10000,
                "type": "array",
                "items": {
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 10000
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "required": [
              "operation"
            ],
            "description": "For a document (type \"document\"): change one section; for a spreadsheet (type \"spreadsheet\"): change some cells or sheets, instead of sending all of it. Leave out content when you send an edit.",
            "additionalProperties": false
          },
          "language": {
            "description": "For type \"code\": the language, as a code fence names it (ts, python, sql).",
            "type": "string",
            "pattern": "^[\\w+-]{1,32}$"
          },
          "title": {
            "description": "A new title; leave out to keep the current one.",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "artifactId"
        ],
        "additionalProperties": false
      },
      "name": "update_artifact",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "object",
                "properties": {
