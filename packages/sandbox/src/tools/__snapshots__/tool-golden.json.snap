      "customModelOutput": false,
      "model": {
        "type": "function",
        "name": "edit",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "newString": {
              "type": "string",
              "maxLength": 1000000
            },
            "oldString": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000000,
              "description": "Exact text to replace; must be unique unless replaceAll"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "replaceAll": {
              "type": "boolean"
            }
