    {
      "approval": "user-approval",
      "customModelOutput": true,
      "model": {
        "type": "function",
        "name": "create_skill",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "description": "One or two sentences: what the skill does and when to use it. Shown in the library and to models choosing a skill."
            },
            "files": {
              "description": "Small text files the skill bundles (templates, examples, reference notes). Leave out when it needs none.",
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "maxLength": 100000,
                    "description": "The file's whole text."
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$)).+$",
                    "description": "Where it sits beside SKILL.md, e.g. templates/notes.md. Relative; no `..`."
                  }
                },
                "required": [
                  "content",
                  "path"
                ],
                "additionalProperties": false
              }
