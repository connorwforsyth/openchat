    {
      "approval": "user-approval",
      "customModelOutput": false,
      "model": {
        "type": "function",
        "name": "write",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "maxLength": 5000000
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "content",
            "path"
          ],
          "additionalProperties": false
        },
        "description": "Create or overwrite a text file in the workspace (/work, the user's Files panel). The change is shown to the user as a diff and may be applied only in part. Writing an .html file shows it in the user's Preview panel on its own; plain HTML, CSS and JS need no server."
      },
      "name": "write",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "const": "unchanged"
              }
            },
            "required": [
              "path",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "applied": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "edit": {
                "type": "object",
                "properties": {
                  "hunks": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "hunkId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "newLines": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "newStart": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "oldLines": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "oldStart": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "hunkId",
                        "newLines",
                        "newStart",
                        "oldLines",
                        "oldStart"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "patch": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "hunks",
                  "patch",
                  "path"
                ],
                "additionalProperties": false
              },
              "feedback": {
                "type": "string"
              },
              "rejected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "const": "changed"
              }
            },
            "required": [
              "applied",
              "edit",
              "rejected",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
