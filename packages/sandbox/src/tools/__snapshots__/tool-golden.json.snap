                "maximum": 65535
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "status": {
                "type": "string",
                "const": "exposed"
              }
            },
            "required": [
              "port",
              "url",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "const": "error"
              }
            },
            "required": [
              "message",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
