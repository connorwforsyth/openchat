    {
      "approval": "user-approval",
      "customModelOutput": false,
      "model": {
        "type": "function",
        "name": "update_memory",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "patches": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "type": "string",
                        "const": "append"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "op",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "find": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "op": {
                        "type": "string",
                        "const": "replace"
                      },
                      "replace": {
                        "type": "string",
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "find",
                      "op",
                      "replace"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "find": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "op": {
                        "type": "string",
                        "const": "delete"
                      }
                    },
                    "required": [
                      "find",
                      "op"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "patches",
            "summary"
          ],
          "additionalProperties": false
        },
        "description": "Edit the user's memory file (Markdown, shown in your instructions). Each patch appends a line, replaces an exact snippet, or deletes an exact snippet; a snippet must occur exactly once in the file. `summary` is one short line for the user, in their language, such as \"Prefers pnpm\"."
      },
      "name": "update_memory",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "previousVersionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "memoryVersion id (UUIDv7)"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "const": "applied"
              },
              "summary": {
                "type": "string"
              },
              "versionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "memoryVersion id (UUIDv7)"
              }
            },
            "required": [
              "number",
              "previousVersionId",
              "status",
              "summary",
              "versionId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
