                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "hunkId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "newLines": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "newStart": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "oldLines": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "oldStart": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "hunkId",
                        "newLines",
                        "newStart",
                        "oldLines",
                        "oldStart"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "patch": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "hunks",
                  "patch",
                  "path"
                ],
                "additionalProperties": false
              },
              "feedback": {
                "type": "string"
              },
              "rejected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
