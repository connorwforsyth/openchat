              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "applied": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "edit": {
                "type": "object",
                "properties": {
                  "hunks": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "hunkId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "newLines": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
