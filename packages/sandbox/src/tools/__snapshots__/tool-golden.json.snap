                      "description": "org id (UUIDv7)"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "type": {
                      "type": "string",
                      "const": "org"
                    }
                  },
                  "required": [
                    "name",
