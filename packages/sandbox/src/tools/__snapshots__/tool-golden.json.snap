              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "The skill's current name, exactly. The person sees it before they approve, and the call is refused if it doesn't match."
            }
          },
          "required": [
            "skillId",
            "skillName"
          ],
          "additionalProperties": false
        },
        "description": "Publish a skill's draft as its next version, so people can pick it in chats. Leave out library to publish it in the person's own library; name a team or org library to publish a copy there too. The person approves it first."
      },
