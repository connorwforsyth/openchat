    {
      "approval": "user-approval",
      "customModelOutput": true,
      "model": {
        "type": "function",
        "name": "create_artifact",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400000,
              "description": "The artifact's complete content, with no surrounding code fence."
            },
            "language": {
              "description": "For type \"code\": the language, as a code fence names it (ts, python, sql).",
              "type": "string",
              "pattern": "^[\\w+-]{1,32}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "A short title the user will recognise it by."
            },
            "type": {
              "type": "string",
              "enum": [
                "code",
                "html",
                "react",
                "markdown",
                "svg",
                "mermaid",
                "site",
                "document",
                "diagram"
              ],
              "description": "document: a rich-text document the user can edit and export, written in Markdown (prefer it for reports, plans and notes). html: one complete HTML document. react: one file with a default-exported component. svg: one <svg> element. diagram: a flowchart the user can rearrange, as JSON nodes and edges with no coordinates (see the Diagrams instructions). mermaid: Mermaid source, for sequence, class, state and other diagrams. markdown: Markdown text that is only read. code: a file in any language. site: a small website of several files, as JSON (see the Sites instructions)."
            }
          },
          "required": [
            "content",
            "title",
            "type"
          ],
          "additionalProperties": false
        },
        "description": "Create an artifact: a self-contained piece of work the user will want to keep, reuse or see rendered (a document, a web page, a React component, an SVG image, a diagram or a code file). It opens beside the chat instead of filling the reply. Use it for substantial content; keep short snippets and explanations in the reply."
      },
      "name": "create_artifact",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "artifact id (UUIDv7)"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "code",
                      "html",
                      "react",
                      "markdown",
                      "svg",
                      "mermaid",
                      "site",
                      "document",
                      "image",
                      "presentation",
                      "spreadsheet",
                      "diagram"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "versionId": {
                    "type": "string",
