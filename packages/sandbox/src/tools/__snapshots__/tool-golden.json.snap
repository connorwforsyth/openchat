      "model": {
        "type": "function",
        "name": "generate_image",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "aspectRatio": {
              "description": "The shape, as width:height (1:1, 16:9, 9:16), when the user asks for one and not for a size.",
              "type": "string",
              "pattern": "^\\d{1,2}:\\d{1,2}$"
            },
            "count": {
              "description": "How many images to make, 1 to 4; 1 unless asked.",
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000,
              "description": "What the image shows, in detail: subject, setting, style, lighting, composition. For an edit, the change to make."
            },
            "size": {
              "description": "The size in pixels, as widthxheight (1024x1024), only when the user asks for one.",
              "type": "string",
              "pattern": "^\\d{2,4}x\\d{2,4}$"
            },
            "source": {
              "description": "To edit an image instead of making a new one: its path in the workspace, like images/harbour-1.png.",
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "prompt"
          ],
          "additionalProperties": false
        },
        "description": "Make an image (or up to four) from a description, or edit an image in the workspace by passing its path as `source`. Use it when the user asks for a picture, illustration, photo, logo or diagram drawn as an image. Each image is shown in the reply, saved in the workspace under images/, and kept as an artifact."
      },
      "name": "generate_image",
