    {
      "approval": "user-approval",
      "customModelOutput": true,
      "model": {
        "type": "function",
        "name": "update_artifact",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "artifactId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "The artifactId create_artifact returned."
            },
            "content": {
              "description": "The artifact's complete new content, with no surrounding code fence. Leave out when you send an edit.",
              "type": "string",
              "minLength": 1,
              "maxLength": 400000
            },
            "edit": {
              "type": "object",
              "properties": {
                "content": {
                  "description": "Markdown for replace_section and insert: the new section body (start it with a heading to replace the heading too) or the blocks to insert. For a diagram's replace: the whole graph as JSON.",
                  "type": "string",
                  "maxLength": 400000
                },
                "edges": {
                  "description": "For a diagram's add_nodes and connect: edges to add, {from, to, label?}. For remove: edges to remove, {from, to}.",
                  "maxItems": 400,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "description": "A short id, unique in the diagram: letters, digits, _ and -."
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "to": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "description": "A short id, unique in the diagram: letters, digits, _ and -."
                      }
                    },
                    "required": [
                      "from",
                      "to"
                    ],
                    "additionalProperties": false
                  }
                },
                "group": {
                  "description": "For a diagram's update_node: the node's new group.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "heading": {
                  "description": "The section's heading text, as it reads (without #s). insert without one adds at the end of the document.",
                  "type": "string",
                  "maxLength": 300
                },
                "id": {
                  "description": "For a diagram's update_node: the node to change.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "ids": {
                  "description": "For a diagram's remove: nodes to remove, with every edge touching them.",
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64,
                    "pattern": "^[A-Za-z0-9_-]+$",
                    "description": "A short id, unique in the diagram: letters, digits, _ and -."
                  }
                },
                "label": {
                  "description": "For a diagram's update_node: the node's new label.",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "nodes": {
                  "description": "For a diagram's add_nodes: nodes to add, {id, label, shape?, group?}.",
                  "maxItems": 200,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "group": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "^[A-Za-z0-9_-]+$",
                        "description": "A short id, unique in the diagram: letters, digits, _ and -."
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "shape": {
                        "default": "rect",
                        "type": "string",
                        "enum": [
                          "rect",
                          "rounded",
                          "stadium",
                          "diamond",
                          "circle"
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "delete_section",
                    "insert",
                    "replace_section",
                    "add_nodes",
                    "connect",
                    "remove",
                    "replace",
                    "update_node"
                  ],
                  "description": "For a document: replace_section, the section under a heading, up to the next heading of the same or a higher level; insert, blocks at a section's start or end, or the document's end; delete_section, a heading and its section. For a diagram: add_nodes, connect, update_node, remove, or replace (the whole graph, keeping the layout)."
                },
                "position": {
                  "description": "For insert: where in the section. section_end by default.",
                  "type": "string",
                  "enum": [
                    "section_end",
                    "section_start"
                  ]
                },
                "shape": {
                  "description": "For a diagram's update_node: the node's new shape.",
                  "type": "string",
                  "enum": [
                    "rect",
                    "rounded",
                    "stadium",
                    "diamond",
                    "circle"
                  ]
                }
              },
              "required": [
                "operation"
              ],
              "description": "For a document (type \"document\"), change one section; for a diagram (type \"diagram\"), change some nodes or edges; instead of sending all of it. Leave out content when you send an edit.",
              "additionalProperties": false
            },
            "language": {
              "description": "For type \"code\": the language, as a code fence names it (ts, python, sql).",
              "type": "string",
              "pattern": "^[\\w+-]{1,32}$"
            },
            "title": {
              "description": "A new title; leave out to keep the current one.",
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "artifactId"
          ],
          "additionalProperties": false
        },
        "description": "Save an artifact's next version; earlier versions are kept. Pass the complete new content, not a diff, or, for a document or a diagram, an edit of one part."
      },
      "name": "update_artifact",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "artifact id (UUIDv7)"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "code",
                      "html",
                      "react",
                      "markdown",
                      "svg",
                      "mermaid",
                      "site",
                      "document",
                      "image",
                      "presentation",
                      "spreadsheet",
                      "diagram"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "versionId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "artifactVersion id (UUIDv7)"
                  }
                },
                "required": [
                  "artifactId",
                  "kind",
                  "title",
                  "versionId"
                ],
                "additionalProperties": false
              },
              "status": {
                "type": "string",
                "const": "saved"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "artifact",
              "status",
              "version"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "problems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "const": "invalid"
              }
            },
            "required": [
              "problems",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "description": "artifact id (UUIDv7)"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "code",
                        "html",
                        "react",
                        "markdown",
                        "svg",
                        "mermaid",
                        "site",
                        "document",
                        "image",
                        "presentation",
                        "spreadsheet",
                        "diagram"
                      ]
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "artifactId",
                    "kind",
                    "title"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "string",
                "const": "not_found"
              }
            },
            "required": [
              "artifacts",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "const": "unavailable"
              }
            },
            "required": [
              "message",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "approval": "not-applicable",
      "customModelOutput": false,
      "model": {
        "type": "function",
        "name": "update_memory",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "patches": {
              "minItems": 1,
              "maxItems": 20,
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "type": "string",
                        "const": "append"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "op",
                      "text"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "find": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "op": {
                        "type": "string",
                        "const": "replace"
                      },
                      "replace": {
                        "type": "string",
                        "maxLength": 4000
                      }
                    },
                    "required": [
                      "find",
                      "op",
                      "replace"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "find": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 4000
                      },
                      "op": {
                        "type": "string",
                        "const": "delete"
                      }
                    },
                    "required": [
                      "find",
                      "op"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "summary": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "patches",
            "summary"
          ],
          "additionalProperties": false
        },
        "description": "Edit the user's memory file (Markdown, shown in your instructions). Each patch appends a line, replaces an exact snippet, or deletes an exact snippet; a snippet must occur exactly once in the file. `summary` is one short line for the user, in their language, such as \"Prefers pnpm\"."
      },
      "name": "update_memory",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "previousVersionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "memoryVersion id (UUIDv7)"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "type": "string",
                "const": "applied"
              },
              "summary": {
                "type": "string"
              },
              "versionId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "description": "memoryVersion id (UUIDv7)"
              }
            },
            "required": [
              "number",
              "previousVersionId",
              "status",
              "summary",
              "versionId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "not_found",
                  "ambiguous",
                  "too_large",
                  "busy"
                ]
              },
              "status": {
                "type": "string",
                "const": "rejected"
              }
            },
            "required": [
              "message",
              "reason",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "approval": "user-approval",
      "customModelOutput": true,
      "model": {
        "type": "function",
        "name": "update_skill",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "description": {
              "description": "A new description.",
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "files": {
              "description": "Files to add or replace, by path; the skill's other files are kept.",
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "maxLength": 100000,
                    "description": "The file's whole text."
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512,
                    "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$)).+$",
                    "description": "Where it sits beside SKILL.md, e.g. templates/notes.md. Relative; no `..`."
                  }
                },
                "required": [
                  "content",
                  "path"
                ],
                "additionalProperties": false
              }
            },
            "instructions": {
              "description": "The whole new body of SKILL.md (not a diff); leave out to keep it.",
              "type": "string",
              "minLength": 1,
              "maxLength": 190000
            },
            "name": {
              "description": "A new name.",
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "removeFiles": {
