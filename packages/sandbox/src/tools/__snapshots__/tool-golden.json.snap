    {
      "approval": "user-approval",
      "customModelOutput": true,
      "model": {
        "type": "function",
        "name": "create_artifact",
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400000,
              "description": "The artifact's complete content, with no surrounding code fence."
            },
            "language": {
              "description": "For type \"code\": the language, as a code fence names it (ts, python, sql).",
              "type": "string",
              "pattern": "^[\\w+-]{1,32}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "A short title the user will recognise it by."
            },
            "type": {
              "type": "string",
              "enum": [
                "code",
                "html",
                "react",
                "markdown",
                "svg",
                "mermaid"
              ],
              "description": "html: one complete HTML document. react: one file with a default-exported component. svg: one <svg> element. mermaid: diagram source. markdown: a document. code: a file in any language."
            }
          },
          "required": [
            "content",
            "title",
            "type"
          ],
          "additionalProperties": false
        },
        "description": "Create an artifact: a self-contained piece of work the user will want to keep, reuse or see rendered (a document, a web page, a React component, an SVG image, a Mermaid diagram or a code file). It opens beside the chat instead of filling the reply. Use it for substantial content; keep short snippets and explanations in the reply."
      },
      "name": "create_artifact",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "artifact": {
                "type": "object",
                "properties": {
                  "artifactId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "artifact id (UUIDv7)"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "code",
                      "html",
                      "react",
                      "markdown",
                      "svg",
                      "mermaid"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "versionId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                    "description": "artifactVersion id (UUIDv7)"
                  }
                },
                "required": [
                  "artifactId",
                  "kind",
                  "title",
                  "versionId"
                ],
                "additionalProperties": false
              },
              "status": {
                "type": "string",
                "const": "saved"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "artifact",
              "status",
              "version"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "problems": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "const": "invalid"
              }
            },
            "required": [
              "problems",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "artifactId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                      "description": "artifact id (UUIDv7)"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "code",
                        "html",
                        "react",
                        "markdown",
                        "svg",
                        "mermaid"
                      ]
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "artifactId",
                    "kind",
                    "title"
                  ],
                  "additionalProperties": false
                }
              },
              "status": {
                "type": "string",
                "const": "not_found"
              }
            },
            "required": [
