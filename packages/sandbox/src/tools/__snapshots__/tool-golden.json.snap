                "type": "string"
              },
              "status": {
                "type": "string",
                "const": "unchanged"
              }
            },
            "required": [
              "path",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "applied": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "edit": {
                "type": "object",
                "properties": {
                  "hunks": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "hunkId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "newLines": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "newStart": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "oldLines": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "oldStart": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "hunkId",
                        "newLines",
                        "newStart",
                        "oldLines",
                        "oldStart"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "patch": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "hunks",
                  "patch",
                  "path"
                ],
                "additionalProperties": false
              },
              "feedback": {
                "type": "string"
              },
              "rejected": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "type": "string",
                "const": "changed"
              }
            },
            "required": [
              "applied",
              "edit",
              "rejected",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "const": "error"
              }
            },
            "required": [
              "message",
              "status"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
