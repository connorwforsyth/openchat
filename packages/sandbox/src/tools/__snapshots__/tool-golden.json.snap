          "properties": {
            "limit": {
              "default": 5,
              "description": "How many passages to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "query": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "What to look for, phrased like the passage you hope to find rather than as a question."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false
        },
        "description": "Search the user's uploaded files and this agent's knowledge files for passages relevant to the query. Cite passages by their [number]."
      },
      "name": "file_search",
      "outputSchema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
