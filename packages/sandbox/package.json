{
  "name": "@workspace/sandbox",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./docker/*": "./src/docker/*.ts",
    "./handlers/*": "./src/handlers/*.ts",
    "./just-bash/*": "./src/just-bash/*.ts",
    "./output": "./src/output.ts",
    "./paths": "./src/paths.ts",
    "./ports/*": "./src/ports/*.ts",
    "./providers": "./src/providers.ts",
    "./remote/*": "./src/remote/*.ts",
    "./runner/*": "./src/runner/*.ts",
    "./tools/*": "./src/tools/*.ts"
