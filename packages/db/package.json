{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./boot-migrate": "./src/boot-migrate.ts",
    "./client": "./src/client.ts",
    "./embedded": "./src/embedded.ts",
    "./errors": "./src/errors.ts",
    "./migrator": "./src/migrator.ts",
    "./queries/*": "./src/queries/*.ts",
    "./schema/*": "./src/schema/*.ts",
    "./testing": "./src/testing.ts",
    "./testing-setup": "./src/testing-setup.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts",
    "lint": "ultracite check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-pgvector": "catalog:",
    "@workspace/contract": "workspace:*",
    "@workspace/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "postgres": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
