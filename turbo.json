{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "globalDependencies": ["tsconfig.json", "biome.jsonc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck", "^i18n:compile", "^icons:select"],
      "env": ["ICON_SET"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^i18n:compile", "^icons:select"],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["//#check:guards"]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "//#typecheck:guards",
        "i18n:compile",
        "^i18n:compile",
        "icons:select",
        "^icons:select"
      ]
    },
    "test": {
      "dependsOn": ["//#test:guards"],
      "outputs": []
    },
    "//#check:guards": {
      "cache": false
    },
    "//#typecheck:guards": {
      "inputs": ["scripts/ci/**", "tsconfig.json"]
    },
    "//#test:guards": {
      "inputs": ["scripts/ci/**", "vitest.config.ts"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "eval": {
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "i18n:compile": {
      "outputs": ["locales/*/messages.ts"]
    },
    "i18n:extract": {
      "cache": false
    },
    "icons:select": {
      "env": ["ICON_SET"],
      "outputs": ["src/selected.ts", "src/selected.native.ts"]
    }
  }
}
