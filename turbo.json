{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "globalDependencies": ["tsconfig.json", "biome.jsonc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["//#check:guards"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "//#typecheck:guards"]
    },
    "test": {
      "dependsOn": ["//#test:guards"],
      "outputs": []
    },
    "//#check:guards": {
      "cache": false
    },
    "//#typecheck:guards": {
      "inputs": ["scripts/ci/**", "tsconfig.json"]
    },
    "//#test:guards": {
      "inputs": ["scripts/ci/**", "vitest.config.ts"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "eval": {
      "outputs": []
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
