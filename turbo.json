{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "globalDependencies": ["tsconfig.json", "biome.jsonc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "typecheck", "^i18n:compile", "^icons:select"],
      "env": ["NEXT_OUTPUT"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^i18n:compile", "^icons:select"],
      "persistent": true
    },
    "desktop:dev": {
      "cache": false,
      "dependsOn": ["^i18n:compile", "^icons:select"],
      "passThroughEnv": ["DESKTOP_INSTANCE_URL", "DESKTOP_USER_DATA"],
      "persistent": true
    },
    "lint": {
      "dependsOn": ["//#check:guards"]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck",
        "//#typecheck:guards",
        "i18n:compile",
        "^i18n:compile",
        "icons:select",
        "^icons:select"
      ]
    },
    "test": {
      "dependsOn": ["//#test:guards"],
      "outputs": []
    },
    "//#check:guards": {
      "cache": false
    },
    "//#typecheck:guards": {
      "inputs": ["scripts/ci/**", "tsconfig.json"]
    },
    "//#test:guards": {
      "inputs": ["scripts/ci/**", "vitest.config.ts"],
      "outputs": []
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "E2E_DEV", "E2E_PORT", "E2E_STANDALONE"]
    },
    "test:desktop": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": ["CI", "E2E_DESKTOP_PORT"]
    },
    "eval": {
      "outputs": []
    },
    "evals": {
      "cache": false,
      "dependsOn": ["^build"],
      "passThroughEnv": [
        "CI",
        "EVALS_PORT",
        "CONFIG_PATH",
        "*_API_KEY",
        "*_BASE_URL"
      ]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "i18n:compile": {
      "outputs": ["locales/*/messages.ts"]
    },
    "i18n:extract": {
      "cache": false
    },
    "icons:select": {
      "env": [
        "CONFIG_PATH",
        "ICON_FILL",
        "ICON_SET",
        "ICON_STYLE",
        "ICON_WEIGHT"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/app.config.yaml",
        "$TURBO_ROOT$/apps/web/app.config.yaml",
        "$TURBO_ROOT$/packages/config/src/parse.ts",
        "$TURBO_ROOT$/packages/config/src/schema.ts"
      ],
      "outputs": [
        "src/selected.ts",
        "src/selected.native.ts",
        "src/sets/material.glyphs.ts"
      ]
    }
  }
}
